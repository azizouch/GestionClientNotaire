        <style>
            /******** loader style********/
            /* Fullscreen loader container */
            #loader {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 0, 0, 0.5);
                display: flex;
                justify-content: center;
                align-items: center;
                z-index: 9999;
            }
            /*!* Spinner animation *!*/
            .spinner {
                width: 50px;
                height: 50px;
                border: 5px solid #fff;
                border-top: 5px solid #3498db;
                border-radius: 50%;
                animation: spin 1s linear infinite;
            }

            @keyframes spin {
                0% { transform: rotate(0deg); }
                100% { transform: rotate(360deg); }
            }
            /******** loader style********/

            .lang-box .lang-center a .lang-img img {
                width: 100%;
                height: 100%;
                border-radius: 5px;
            }

            .lang-box .lang-center a {
                display: flex;
                color: #4d585f;
            }

            .sidebar-content {
                display: flex;
                flex-direction: column; /* Arrange items in a column */
                height: 100%; /* Ensure the sidebar takes full height */
            }

            .nav {
                flex: 1; /* Allow the nav to grow and take remaining space */
            }

            .sidebar-info {
                margin-top: auto;
                display: flex;
                align-items: center;
                justify-content: space-around;
            }

            .sidebar-info .u-text{
                padding: 0 10px;
            }

            .log_out i{
                color: #b9babf;
                cursor: pointer;
                margin-left: 20px;
                margin-top: 10px;
            }

            .log_out i:hover{
                color: blue;
            }

            @media (max-width: 1023px) {
                .drop_lang{
                    width: 140px;
                }
            }

            .sidebar_minimize .sidebar-info {
                margin-left: 0;
            }

            .sidebar_minimize.sidebar_minimize_hover .sidebar-info {
                margin-left: 30px;
            }

            /* chat style*/
            .user-list {
                max-height: 300px;
                overflow-y: auto;
                margin-bottom: 15px;
            }

            .user-message {
                display: flex;
                align-items: center;
                padding: 10px;
                cursor: pointer;
            }

            .user-message:hover {
                background-color: #f1f1f1;
            }

            .user-profile {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                margin-right: 10px;
            }

            .user-details {
                flex-grow: 1;
            }

            .last-message {
                margin: 0;
            }

            .chat-box {
                max-height: 300px;
                overflow-y: auto;
                margin-bottom: 15px;
                background-color: #fff;
                border-radius: 5px;
                padding: 10px;
                border: 1px solid #dee2e6;
                display: flex;
                flex-direction: column;
            }

            .message {
                padding: 8px;
                margin-bottom: 10px;
                border-radius: 5px;
                max-width: 80%;
            }

            .sent {
                background-color: #007bff;
                color: white;
                align-self: flex-end; /* Align to the right */
                margin-left: auto; /* Align to the right */
            }

            .received {
                background-color: #e9ecef;
                color: black;
                align-self: flex-start; /* Align to the left */
                margin-right: auto; /* Align to the left */
            }

            /* Add flex properties to chat box for alignment */
            .input-group {
                position: relative;
            }

            .search-input {
                width: auto;
                margin-left: auto;
            }

            .sidebar-wrapper .nav-item a.active {
                color: white !important;
                font-weight: bold;
            }

            .nav-item .collapse.show > .nav-collapse a.active {
                color: #fff !important;
                position: relative; /* Ensure the parent `<a>` acts as the positioning context */
            }

            .nav-item .collapse.show > .nav-collapse a.active .arrow {
                position: absolute; /* Allow positioning relative to the `<a>` element */
                top: 50%; /* Center the arrow vertically */
                right: 32px; /* Keep the arrow 25px from the right border */
                border: solid #6861ce; /* Arrow styling */
                border-width: 0 3px 3px 0;
                display: inline-block;
                padding: 3px;
                transform: translateY(-50%) rotate(-45deg); /* Center and rotate for the arrow effect */
                -webkit-transform: translateY(-50%) rotate(-45deg); /* For older browsers */
            }

            .error {
                border: 2px solid red; /* Red border for error indication */
            }

            .error-message {
                color: red;
                font-size: 0.9em;
                margin-top: 0.25rem;
                margin-left: 2.5rem;
                display: none; /* Initially hidden */
            }

            .btn-icon{
                height: 1.5rem;
            }

            .unseen-message {
                font-weight: bold;
                background-color: #f8f9fa;
            }
            .scroll-top-btn {
                position: fixed;
                bottom: 50px;
                right: 20px;
                width: 40px;
                height: 40px;
                background-color: black;
                color: white;
                border: none;
                border-radius: 50%;
                display: none;
                justify-content: center;
                align-items: center;
                font-size: 20px;
                cursor: pointer;
                z-index: 9999;
                box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
                transition: opacity 0.3s, visibility 0.3s;
            }

            .scroll-top-btn:hover {
                background-color: #566573;
            }


        </style>

