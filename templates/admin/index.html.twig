                        <div class="card-body scrollbar scrollbar-inner">
                            <div style="height: 300px">
                                <!-- Projects table -->
                                <table class="table table-responsive align-items-center mb-0">
                                    <thead class="thead-light">
                                    <tr>
                                        <th scope="col" class="text-capitalize small">Repertoire</th>
                                        <th scope="col" class="text-capitalize small">Client(S)</th>
                                        <th scope="col" class="text-capitalize small">Devis</th>
                                        <th scope="col" class="text-capitalize small">Paiements</th>
                                        <th scope="col" class="text-capitalize small">Reste à payer</th>
                                        <th scope="col" class="text-capitalize small">Statut</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for dossier in dossiers %}
                                        {% set rest = dossier.devis - dossier.getTotalPaiement() %}
                                        <tr>
                                            <td class="fw-bold">{{ dossier.repertoir }}</td>
                                            <td>
                                                {# Display the name of the person with the role 'Bénéficiaire' #}
                                                {% if dossier.getCompromis() %}

                                                    {% set beneficiariesPysique = dossier.getCompromis().getPphysique()|filter(person => 'Bénéficiaire' in person.getRoles()|map(role => role.name)) %}
                                                    <ul class="m-0">
                                                        {% for person in beneficiariesPysique %}
                                                            <li>{{ person.firstName }} {{ person.lastName }}</li>
                                                        {% endfor %}
                                                    </ul>

                                                    {% set beneficiariesMorale = dossier.getCompromis().getPmorale()|filter(person => 'Bénéficiaire' in person.getRoles()|map(role => role.name)) %}
                                                    <ul class="m-0">
                                                        {% for person in beneficiariesMorale %}
                                                            <li>{{ person.name }}</li>
                                                            {% if count > 1 and loop.index < count %} <br> {% endif %}
                                                        {% endfor %}
                                                    </ul>

                                                {% elseif dossier.getProcuration() %}
                                                    {# Mandataires #}
                                                    {% set MandatairePerson = dossier.getProcuration.getPersons()|filter(person => 'Mandataire' in person.getRoles()|map(role => role.name)) %}
                                                    <ul class="m-0">
                                                        {% for person in MandatairePerson %}
                                                            <li>{{ person.firstName }} {{ person.lastName }}</li>
                                                        {% endfor %}
                                                    </ul>
                                                {% endif %}

                                            </td>
                                            <td>{{ dossier.devis|number_format(2, '.', ' ') }} DH</td>
                                            <td>{{ dossier.getTotalPaiement()|number_format(2, '.', ' ') }} DH</td>
                                            <td>{{ rest|number_format(2, '.', ' ') }} DH</td>
                                            <td>
                                                {% if rest == 0 %}
                                                    <span class="badge badge-success">Complete</span>
                                                {% else %}
                                                    <span class="badge badge-warning">En cour...</span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
