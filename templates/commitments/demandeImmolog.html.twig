<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>PDF Document</title>
    <style>
        body {
            font-family: Arial, sans-serif;
        }
        strong{
            font-family: "Times New Roman";
            font-size:20px;
        }
        .date {
            font-family: "Times New Roman";
            text-align: right;
            margin-top: 10px;
            padding-right: 40px;
        }
        .signature{
            font-size: 17px;
            font-family: "Times New Roman";
            text-align: center;
            margin-left: 200px;
            margin-top: 40px;
        }
        .info {
            margin-bottom: 20px;
        }
        .uppercase{
            text-transform: uppercase;
            font-size: 18px;
        }
        .pied {
            position: absolute;
            bottom: 0;
            text-align: center;
            border-top: 1px solid #6c6363;
            width: 100%;
        }
        .buttom{
            color: #0059ff;
            font-family: "Times New Roman";
            font-weight: bold;
        }
        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #6c6363;
            margin-bottom: 10px;
        }
        .logo {
            width: 130px;
            height: auto;
        }
        .Left.logo{
            position: absolute;
            left: 0;top: 0
        }
        .Right.logo{
            position: absolute;
            right: 0;top: 0
        }
        .title {
            color:#0059ff;
            font-size: 27px;
            text-align: center;
            flex-grow: 1;
            margin-top: 40px;


        }
        .content{
            line-height: 1.5;
            padding-left: 40px;
            padding-right: 40px;
        }

    </style>
</head>
