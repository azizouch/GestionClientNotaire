        });

        document.getElementById('ajouterBeneficiaire').addEventListener('click', () => {
            selectedRole = 'Bénéficiaire'; // Set the role to "Bénéficiaire"
        });

        // Function to renumber partner labels dynamically
        function renumberPartners() {
            let partners = partnerContainer.querySelectorAll('[id^="partnerFields"]');
            let index = 1;

            partners.forEach(partner => {
                partner.querySelector("label.form-label").textContent = `Partenaire ${index}`;

                // Update input names to maintain unique identifiers
                partner.querySelectorAll("input").forEach(input => {
                    let baseName = input.name.split("_")[0]; // Get field name without index
                    input.name = baseName + "_" + index; // Assign new index
                });

                partner.id = "partnerFields_" + index;
                index++;
            });

            // Update global counter to the next available index
            partnerIndex = partners.length;
        }

        // Function to toggle forms based on radio selection
        function toggleFormVisibility() {
            if (physiqueRadio.checked) {
                physiqueForm.style.display = 'block';
                moraleForm.style.display = 'none';
            } else if (moraleRadio.checked) {
                physiqueForm.style.display = 'none';
                moraleForm.style.display = 'block';
            }
        }

        addButton.addEventListener("click", function() {
            partnerIndex++; // Increment index for next partner

            // Clone the first partner fields
            const newPartner = firstPartner.cloneNode(true);

            // Update the new partner's label
            newPartner.querySelector("label.form-label").textContent = `Partenaire ${partnerIndex}`;

            // Update input fields with unique names and clear values
            newPartner.querySelectorAll("input").forEach(input => {
                input.value = ""; // Clear the input fields
                let name = input.name.split("_")[0]; // Get field name without index
                input.name = name + "_" + partnerIndex; // Assign new index
            });

            // Assign a new ID to the partner div
            newPartner.id = "partnerFields_" + partnerIndex;

            // Append the new partner fields to the container
            // Remove any existing delete button (prevents duplicates when cloning)
            const existingDeleteButton = newPartner.querySelector(".delete-partner");
            if (existingDeleteButton) {
                existingDeleteButton.remove();
            }

            // Create a delete button
            const deleteButton = document.createElement("button");
            deleteButton.textContent = "Supprimer";
            deleteButton.classList.add("delete-partner", "btn", "btn-danger", "my-2","btn-sm");
            deleteButton.type = "button"; // Prevent form submission

            // Add event listener to remove partner fieldset
            deleteButton.addEventListener("click", function() {
                newPartner.remove();
                renumberPartners();
            });

            // Append the delete button to the partner div
            newPartner.appendChild(deleteButton);

            // Append the new partner fields to the container
            partnerContainer.insertBefore(newPartner, addButton);
            renumberPartners();
        });

