    <script>
        function populateTables() {
            const benefTableBody = document.querySelector('#BeneficiaireTable tbody');
            const promettantTableBody = document.querySelector('#PromettantTable tbody');

            // Helper function to append rows based on role
            function appendRowToTable(values, newRow, fieldset) {
                newRow.find('.delete-client').on('click', function () {
                    newRow.remove(); // Remove row from table
                    fieldset.remove(); // Remove associated fieldset
                });

                if (values.roles.includes('Promettant')) {
                    promettantTableBody.appendChild(newRow[0]);
                } else if (values.roles.includes('Bénéficiaire')) {
                    benefTableBody.appendChild(newRow[0]);
                }
            }

            // Clear existing rows in both tables
            benefTableBody.innerHTML = '';
            promettantTableBody.innerHTML = '';

            // Get fieldsets for both persons
            const fieldsetsPhysique = document.querySelectorAll('#contrat_pphysique > fieldset');
            const fieldsetsMorale = document.querySelectorAll('#contrat_pmorale > fieldset');

            // Process physical persons
            fieldsetsPhysique.forEach(fieldset => {
                const values = {
                    name: fieldset.querySelector('input[name*="[first_name]"]').value + ' ' + fieldset.querySelector('input[name*="[last_name]"]').value,
                    identifiant: fieldset.querySelector('input[name*="[cin]"]').value,
                    ville: fieldset.querySelector('input[name*="[city]"]').value,
                    telephone: fieldset.querySelector('input[name*="[telephone]"]').value,
                    email: fieldset.querySelector('input[name*="[email]"]').value,
                    roles: Array.from(fieldset.querySelectorAll('input[name*="[roles]"]')).map(role => role.value).join(', '), // Collect roles
                };

                const newRow = $(`
                    <tr data-cin="${values.identifiant}">
                        <td>${values.name}</td>
                        <td>CIN: ${values.identifiant}</td>
                        <td>${values.ville}</td>
                        <td>${values.telephone}</td>
                        <td>${values.email}</td>
                        <td class="text-center"><button type="button" class="btn btn-danger btn-sm delete-client"><i class="fas fa-trash-alt"></i></button></td>
                    </tr>
                `);
                fieldset.setAttribute('data-cin', values.identifiant);

                // Add to the appropriate table based on the role
                // Use the helper function to append the row
                appendRowToTable(values, newRow, fieldset);
            });

            // Process moral persons
            fieldsetsMorale.forEach(fieldset => {
                const values = {
                    name: fieldset.querySelector('input[name*="[name]"]').value, // Adjust based on your input names
                    identifiant: fieldset.querySelector('input[name*="[RC]"]').value,
                    ville: fieldset.querySelector('input[name*="[ville]"]').value,
                    telephone: "",
                    email: "",
                    roles: Array.from(fieldset.querySelectorAll('input[name*="[roles]"]')).map(role => role.value).join(', '), // Collect roles
                };

                const newRow = $(`
                    <tr data-if="${values.identifiant}">
                        <td>${values.name}</td>
                        <td>RC: ${values.identifiant}</td>
                        <td>${values.ville}</td>
                        <td>${values.telephone}</td>
                        <td>${values.email}</td>
                        <td class="text-center"><button type="button" class="btn btn-danger btn-sm delete-client"><i class="fas fa-trash-alt"></i></button></td>
                    </tr>
                `);
                fieldset.setAttribute('data-if', values.identifiant);
                // Add to the appropriate table based on the role
                // Use the helper function to append the row
                appendRowToTable(values, newRow, fieldset);
            });
        }

        // Call populateTables when needed (e.g., on form submission or button click)
        populateTables(); // Uncomment to run this function
    </script>

