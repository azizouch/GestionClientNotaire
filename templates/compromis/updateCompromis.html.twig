                const personIdentifiant = $(this).find('td:nth-child(2)').text(); // Identifiant (CIN or RC)
                const personVille = $(this).find('td:nth-child(3)').text(); // Ville
                const personTel = $(this).find('td:nth-child(4)').text(); // Telephone
