                                            <button type="button" class="btn btn-light " id="ajouterBeneficiaire" data-bs-toggle="modal" data-bs-target="#newClientModal">
                                                <i class="fas fa-plus-circle"></i>
                                                Ajouter une ligne
                                            </button>
                                        </div>
