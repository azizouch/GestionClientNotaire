{% extends '_base.html.twig' %}

{% block title %}Modifier compromis{% endblock %}

{% block body %}

    <style>
        .form-control{
            border: 0.5px solid lightgrey;
        }
        #newClientModal2 {
            color: #adb5bd; /* Applies white text color to all content inside the modal */
        }

        #newClientModal2 label {
            color: #adb5bd !important; /* Ensures all form labels are white */
        }

        #newClientModal2 .btn-close {
            filter: invert(100%); /* Makes the close button visible on a dark background */
        }
        #newClientModal2 .modal-body {
            max-height: 600px;
            overflow: auto;
        }
        #newClientModal2 .modal-header{
            border-bottom: 1px solid #adb5bd !important;
        }
        #newClientModal2 .modal-footer{
            border-top: 1px solid #adb5bd !important;
        }
        .shake {
            animation: shake 0.3s ease-in-out;
        }

        @keyframes shake {
            0% { transform: translateX(0); }
            25% { transform: translateX(-5px); }
            50% { transform: translateX(5px); }
            75% { transform: translateX(-5px); }
            100% { transform: translateX(0); }
        }
        .basetable thead th{
            text-transform: capitalize;
            background-color: #d0ece7;
        }
        #clientsTables tbody tr {
            cursor: pointer;
        }

        /* Custom Scrollbar for WebKit Browsers (Chrome, Safari) */
        #newClientModal2 .modal-body::-webkit-scrollbar {
            width: 10px; /* Width of the scrollbar */
        }

        #newClientModal2 .modal-body::-webkit-scrollbar-track {
            background: #f1f1f1; /* Background of the scrollbar track */
            border-radius: 10px; /* Rounded corners for track */
        }

        #newClientModal2 .modal-body::-webkit-scrollbar-thumb {
            background: #888; /* Color of the scrollbar thumb */
            border-radius: 10px; /* Rounded corners for thumb */
        }

        #newClientModal2 .modal-body::-webkit-scrollbar-thumb:hover {
            background: #555; /* Color of the scrollbar thumb on hover */
        }

        /* Custom Scrollbar for Firefox */
        #newClientModal2 .modal-body {
            scrollbar-width: thin; /* Make the scrollbar thin */
            scrollbar-color: #888 #f1f1f1; /* Color of the scrollbar thumb and track */
        }

    </style>

    <div class="container">
        <div class="page-inner pt-3">
            <div class="page-header m-0">
                <h3 class="fw-bold mb-3">Ajouter compromis</h3>
                <ul class="breadcrumbs mb-3">
                    <li class="nav-home">
                        <a href="{{ path('app_admin') }}">
                            <i class="icon-home"></i>
                        </a>
                    </li>
                    <li class="separator">
                        <i class="icon-arrow-right"></i>
                    </li>
                    <li class="nav-item">
                        <a href="#">Compromis</a>
                    </li>
                    <li class="separator">
                        <i class="icon-arrow-right"></i>
                    </li>
                    <li class="nav-item">
                        <a href="#">Créer un nouveau compromis</a>
                    </li>
                </ul>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-body">
                            <ul class="nav nav-tabs nav-line nav-color-secondary" id="line-tab" role="tablist">
                                <li class="nav-item submenu" role="presentation">
                                    <a class="nav-link active" id="line-social-tab" data-bs-toggle="pill" href="#line-social" role="tab" aria-controls="pills-home" aria-selected="true">Compromis social</a>
                                </li>
                                <li class="nav-item submenu" role="presentation">
                                    <a class="nav-link" id="line-social-bank-tab" data-bs-toggle="pill" href="#line-social-bank" role="tab" aria-controls="pills-home" aria-selected="false">Compromis social bank</a>
                                </li>
                                <li class="nav-item submenu" role="presentation">
                                    <a class="nav-link" id="line-social-tva" data-bs-toggle="pill" href="#line-tva" role="tab" aria-controls="pills-home" aria-selected="false">Compromis social sans TVA</a>
                                </li>
                                <li class="nav-item submenu" role="presentation">
                                    <a class="nav-link" id="line-bureau-tab" data-bs-toggle="pill" href="#line-bureau" role="tab" aria-controls="pills-profile" aria-selected="false" tabindex="-1">Compromis bureau</a>
                                </li>
                                <li class="nav-item submenu" role="presentation">
                                    <a class="nav-link" id="line-contact-tab" data-bs-toggle="pill" href="#line-contact" role="tab" aria-controls="pills-contact" aria-selected="false" tabindex="-1">Autre</a>
                                </li>
                            </ul>
                            <div class="tab-content mt-3 mb-3" id="line-tabContent">
                                <div class="tab-pane fade active show" id="line-social" role="tabpanel" aria-labelledby="line-social-tab">
                                    <div class="container card-body">
                                        {{ form_start(form)}}
                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                {{ form_row(form.repertoir) }}
                                            </div>
                                            <div class="col-md-6">
                                                {{ form_label(form.designation.numero_bien) }}
                                                {{ form_widget(form.designation.numero_bien, { 'attr': { 'class': 'form-control shadow-sm' } }) }}
                                            </div>
                                        </div>
                                        <div class="row mb-3">
                                            <fieldset class="mb-3">
                                                <legend class="col-form-label required mb-3">Designation</legend>
                                                <div id="compromis_designation">
                                                    <div class="row mb-3">
                                                        <div class="col-md-4">
                                                            {{ form_label(form.designation.titre_foncier) }}
                                                            {{ form_widget(form.designation.titre_foncier, { 'attr': { 'class': 'form-control shadow-sm' } }) }}
                                                        </div>
                                                        <div class="col-md-4">
                                                            {{ form_label(form.designation.titre_foncier_mere) }}
                                                            {{ form_widget(form.designation.titre_foncier_mere, { 'attr': { 'class': 'form-control shadow-sm' } }) }}
                                                        </div>
                                                        <div class="col-md-4">
                                                            {{ form_label(form.designation.delai) }}
                                                            {{ form_widget(form.designation.delai, { 'attr': { 'class': 'form-control shadow-sm' } }) }}
                                                        </div>
                                                    </div>
                                                    <div class="row mb-3">
                                                        <div class="col-md-4">
                                                            {{ form_label(form.designation.montant_TTC) }}
                                                            {{ form_widget(form.designation.montant_TTC, { 'attr': { 'class': 'form-control shadow-sm' } }) }}
                                                        </div>
                                                        <div class="col-md-4">
                                                            {{ form_label(form.designation.montant_HT) }}
                                                            {{ form_widget(form.designation.montant_HT, { 'attr': { 'class': 'form-control shadow-sm' } }) }}
                                                        </div>
                                                        <div class="col-md-4">
                                                            {{ form_label(form.designation.TVA) }}
                                                            {{ form_widget(form.designation.TVA, { 'attr': { 'class': 'form-control shadow-sm' } }) }}
                                                        </div>
                                                    </div>
                                                    <div class="row mb-3">
                                                        <div class="col-md-4">
                                                            {{ form_label(form.designation.etage) }}
                                                            {{ form_widget(form.designation.etage, { 'attr': { 'class': 'form-control shadow-sm' } }) }}
                                                        </div>
                                                        <div class="col-md-4">
                                                            {{ form_label(form.designation.superficie) }}
                                                            {{ form_widget(form.designation.superficie, { 'attr': { 'class': 'form-control shadow-sm' } }) }}
                                                        </div>
                                                        <div class="col-md-4">
                                                            {{ form_label(form.designation.Nombre_salon) }}
                                                            {{ form_widget(form.designation.Nombre_salon, { 'attr': { 'class': 'form-control shadow-sm' } }) }}
                                                        </div>
                                                    </div>
                                                    <div class="row mb-3">
                                                        <div class="col-md-4">
                                                            {{ form_label(form.designation.nombre_chambre) }}
                                                            {{ form_widget(form.designation.nombre_chambre, { 'attr': { 'class': 'form-control shadow-sm' } }) }}
                                                        </div>
                                                        <div class="col-md-4">
                                                            {{ form_label(form.designation.nombre_cuisine) }}
                                                            {{ form_widget(form.designation.nombre_cuisine, { 'attr': { 'class': 'form-control shadow-sm' } }) }}
                                                        </div>
                                                        <div class="col-md-4">
                                                            {{ form_label(form.designation.nombre_sallon_de_bain) }}
                                                            {{ form_widget(form.designation.nombre_sallon_de_bain, { 'attr': { 'class': 'form-control shadow-sm' } }) }}
                                                        </div>
                                                    </div>
                                                    <div class="row mb-3">
                                                        <div class="col-md-4">
                                                            {{ form_label(form.designation.numero_divise) }}
                                                            {{ form_widget(form.designation.numero_divise, { 'attr': { 'class': 'form-control shadow-sm' } }) }}
                                                        </div>
                                                        <div class="col-md-4">
                                                            {{ form_label(form.designation.indivision) }}
                                                            {{ form_widget(form.designation.indivision, { 'attr': { 'class': 'form-control shadow-sm' } }) }}
                                                        </div>
                                                        <div class="col-md-4">
                                                            {{ form_label(form.designation.residence) }}
                                                            {{ form_widget(form.designation.residence, { 'attr': { 'class': 'form-control shadow-sm' } }) }}
                                                        </div>
                                                    </div>
                                                    <div class="row mb-3">
                                                        <div class="col-md-12">
                                                            {{ form_label(form.designation.adresse) }}
                                                            {{ form_widget(form.designation.adresse, { 'attr': { 'class': 'form-control shadow-sm' } }) }}
                                                        </div>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col-md-4">
                                                {{ form_row(form.date_promettant, { 'attr': { 'class': 'form-control shadow-sm' } }) }}
                                            </div>
                                            <div class="col-md-4">
                                                {{ form_row(form.date_beneficiaire, { 'attr': { 'class': 'form-control shadow-sm' } }) }}
                                            </div>
                                            <div class="col-md-4">
                                                {{ form_row(form.date_maitre, { 'attr': { 'class': 'form-control shadow-sm' } }) }}
                                            </div>
                                        </div>
                                        <div class="row d-none">
                                            <div class="col-md-4">
                                                {{ form_row(form.type) }}
                                            </div>
                                            <div class="col-md-4">
                                                {{ form_row(form.createdAt) }}
                                            </div>
                                            <div class="col-md-4">
                                                {{ form_row(form.updatedAt) }}
                                            </div>
                                        </div>
                                        <div class="pphysiqueContainer mb-3 d-none">
                                            {{ form_row(form.pphysique) }}
                                        </div>
                                        <div class="pmoraleContainer mb-3 d-none">
                                            {{ form_row(form.pmorale) }}
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col-md-12">
                                                <div class="card shadow">
                                                    <div class="card-header">
                                                        <div class="card-title">Promettant(s)</div>
                                                    </div>
                                                    <div class="card-body">
                                                        <div class="table-responsive">
                                                            <table class="table table-hover" id="PromettantTable">
                                                                <thead>
                                                                <tr>
                                                                    <th scope="col" class="text-capitalize">Dénomination/Nom Prenom</th>
                                                                    <th scope="col" class="text-capitalize">Identifiant</th>
                                                                    <th scope="col" class="text-capitalize">Ville</th>
                                                                    <th scope="col" class="text-capitalize">Telephone</th>
                                                                    <th scope="col" class="text-capitalize">Email</th>
                                                                    <th scope="col" class="text-capitalize">Actions</th>
                                                                </tr>
                                                                </thead>
                                                                <tbody>
                                                                <!-- Client entries will go here -->
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                    <div class="card-footer">
                                                        <!-- Button to Open the Modal -->
                                                        <button type="button" class="btn btn-light " id="ajouterPromettant" data-bs-toggle="modal" data-bs-target="#newClientModal">
                                                            <i class="fas fa-plus-circle"></i>
                                                            Ajouter une ligne
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col-md-12">
                                                <div class="card shadow">
                                                    <div class="card-header">
                                                        <div class="card-title">Bénéficiaire(s)</div>
                                                    </div>
                                                    <div class="card-body">
                                                        <div class="table-responsive">
                                                            <table class="table table-hover" id="BeneficiaireTable">
                                                                <thead>
                                                                <tr>
                                                                    <th scope="col" class="text-capitalize">Dénomination/Nom Prenom</th>
                                                                    <th scope="col" class="text-capitalize">Identifiant</th>
                                                                    <th scope="col" class="text-capitalize">Ville</th>
                                                                    <th scope="col" class="text-capitalize">Telephone</th>
                                                                    <th scope="col" class="text-capitalize">Email</th>
                                                                    <th scope="col" class="text-capitalize">Actions</th>
                                                                </tr>
                                                                </thead>
                                                                <tbody>
                                                                <!-- Client entries will go here -->
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                    <div class="card-footer">
                                                        <!-- Button to Open the Modal -->
                                                        <button type="button" class="btn btn-light " id="ajouterBeneficiaire" data-bs-toggle="modal" data-bs-target="#newClientModal">
                                                            <i class="fas fa-plus-circle"></i>
                                                            Ajouter une ligne
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            {{ form_row(form.Submit, { 'label': 'Modifier' }) }}
                                        </div>
                                        {{ form_end(form) }}
                                        <!-- Modal for Client Selection -->
                                        <div class="modal fade" id="newClientModal" tabindex="-1" aria-labelledby="newClientModalLabel" aria-hidden="true">
                                            <div class="modal-dialog modal-lg">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title" id="newClientModalLabel">Ajouter</h5>

                                                        <input type="text" id="searchInputPerson" class="form-control" placeholder="Search for a person..." style="margin-right: 20px;margin-left: 20px">

                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <div class="table-responsive">
                                                            <table class="table table-hover basetable" id="clientsTables">
                                                                <thead>
                                                                <tr style="text-transform: capitalize">
                                                                    <th>Denomination/Nom/Prenom</th>
                                                                    <th>Identifiant</th>
                                                                    <th>Ville</th>
                                                                    <th>Telephone</th>
                                                                    <th>Email</th>
                                                                </tr>
                                                                </thead>
                                                                <tbody class="tablebody">
                                                                {% for person in PersonnesPhysiques %}
                                                                    <tr data-id="{{ person.id }}" data-cin="{{ person.cin }}" data-type="personPhysique">
                                                                        <td>{{ person.firstName }} {{ person.lastName }}</td>
                                                                        <td>CIN: {{ person.cin }}</td>
                                                                        <td>{{ person.city }}</td>
                                                                        <td>{{ person.telephone }}</td>
                                                                        <td>{{ person.email }}</td>
                                                                    </tr>
                                                                {% endfor %}
                                                                {% for personne in PersonnesMorales %}
                                                                    <tr data-id="{{ personne.id }}" data-if="{{ personne.RC }}" data-type="personMorale">
                                                                        <td>{{ personne.name }}</td>
                                                                        <td>RC: {{ personne.RC }}</td>
                                                                        <td>{{ personne.Ville }}</td>
                                                                        <td>{{ personne.telephone }}</td>
                                                                        <td>{{ personne.email }}</td>
                                                                    </tr>
                                                                {% endfor %}
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                                                        <button type="button" class="btn btn-primary" id="addNewClientButton" data-bs-toggle="modal" data-bs-target="#newClientModal2">Nouveau</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- New Client Modal -->
                                        <div class="modal fade" id="newClientModal2" tabindex="-1" aria-labelledby="newClientModal2Label" aria-hidden="true">
                                            <div class="modal-dialog modal-lg">
                                                <div class="modal-content" style="background-color: #343a40">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title" id="newClientModal2Label">Créer</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <div class="text-center">
                                                            <!-- Radio buttons for type selection -->
                                                            <div class="form-check form-check-inline ms-3 text-center">
                                                                <input class="form-check-input" type="radio" name="personType" id="personnePhysique" value="physique" checked>
                                                                <label class="form-check-label" for="personnePhysique">Personne Physique</label>
                                                            </div>
                                                            <div class="form-check form-check-inline">
                                                                <input class="form-check-input" type="radio" name="personType" id="personneMorale" value="morale">
                                                                <label class="form-check-label" for="personneMorale">Personne Morale</label>
                                                            </div>
                                                        </div>
                                                        <!-- Personne Physique Form -->
                                                        <form class="container" id="personnePhysiqueForm">
                                                            <div class="row mb-3 justify-content-center">
                                                                <div class="d-flex justify-content-center align-items-center col-md-8">
                                                                    <div class="col-md-2">
                                                                        <label class="form-label mb-0" for="civilite" >Civilité</label>
                                                                    </div>
                                                                    <div class="col-md-10">
                                                                        <select id="civilite" class="form-select" required>
                                                                            <option value="" disabled selected>Choisissez une civilité...</option>
                                                                            <option value="Monsieur">Monsieur</option>
                                                                            <option value="Madame">Madame</option>
                                                                            <option value="Mademoiselle">Mademoiselle</option>
                                                                        </select>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="row mb-3">
                                                                <div class="col-md-6">
                                                                    <label for="firstName" class="form-label required" >Prenom</label>
                                                                    <input type="text" class="form-control" id="firstName" required>
                                                                </div>
                                                                <div class="col-md-6">
                                                                    <label for="lastName" class="form-label required">Nom</label>
                                                                    <input type="text" class="form-control" id="lastName" required>
                                                                </div>
                                                            </div>
                                                            <div class="row mb-3">
                                                                <div class="col-md-6">
                                                                    <label for="firstNameFather" class="form-label required">Prenom du pere</label>
                                                                    <input type="text" class="form-control" id="firstNameFather" required>
                                                                </div>
                                                                <div class="col-md-6">
                                                                    <label for="firstNameMother" class="form-label required">Prenom du mere</label>
                                                                    <input type="text" class="form-control" id="firstNameMother" required>
                                                                </div>
                                                            </div>
                                                            <div class="row mb-3">
                                                                <div class="col-md-6">
                                                                    <label for="cin" class="form-label required">CIN</label>
                                                                    <input type="text" class="form-control" id="cin" required>
                                                                </div>
                                                                <div class="col-md-6">
                                                                    <label for="birth_place" class="form-label required">Lieu de naissance</label>
                                                                    <input type="text" class="form-control" id="birth_place" required>
                                                                </div>
                                                            </div>
                                                            <div class="row mb-3">
                                                                <div class="col-md-6">
                                                                    <label for="DateExpiration" class="form-label required">Date d'expiration du CIN</label>
                                                                    <input type="date" class="form-control" id="DateExpiration" required>
                                                                </div>
                                                                <div class="col-md-6">
                                                                    <label for="DateNaissance" class="form-label required">Date de naissance</label>
                                                                    <input type="date" class="form-control" id="DateNaissance" required>
                                                                </div>
                                                            </div>
                                                            <div class="row mb-3">
                                                                <div class="col-md-6">
                                                                    <label for="genre" class="form-label required">Genre</label>
                                                                    <select id="genre" class="form-select" required>
                                                                        <option value="" disabled selected>Choisissez une genre...</option>
                                                                        <option value="Male">Male</option>
                                                                        <option value="Femelle">Femelle</option>
                                                                    </select>
                                                                </div>
                                                                <div class="col-md-6">
                                                                    <label for="situation" class="form-label required">Situation familiale</label>
                                                                    <select id="situation" class="form-select" required>
                                                                        <option value="" disabled selected>Choisissez une situation...</option>
                                                                        <option value="Célibataire">Célibataire</option>
                                                                        <option value="Marié">Marié</option>
                                                                        <option value="Veuf">Veuf</option>
                                                                        <option value="Veuve">Veuve</option>
                                                                    </select>
                                                                </div>
                                                            </div>
                                                            <div class="row " id="partenaire" style="display: none">
                                                                <label class="form-label">Partenaires</label>
                                                            </div>
                                                            <div class="container mb-3 rounded-1 p-2" id="partnerContainer" style="display: none;border: 0.5px solid #adb5bd">
                                                                <div class="container " id="partnerFields">
                                                                    <label class="form-label">Partenaire 1</label>
                                                                    <div class="row mb-3">
                                                                        <div class="col-md-6">
                                                                            <label for="partnerFirstName" class="form-label">Prenom</label>
                                                                            <input type="text" class="form-control" id="partnerFirstName" required>
                                                                        </div>
                                                                        <div class="col-md-6">
                                                                            <label for="partnerLastName" class="form-label">Nom</label>
                                                                            <input type="text" class="form-control" id="partnerLastName" required>
                                                                        </div>
                                                                    </div>
                                                                    <div class="row mb-3">
                                                                        <div class="col-md-6">
                                                                            <label for="mariagePlace" class="form-label">Lieu de mariage</label>
                                                                            <input type="text" class="form-control" id="mariagePlace" required>
                                                                        </div>
                                                                        <div class="col-md-6">
                                                                            <label for="mariageYear" class="form-label">Année de mariage</label>
                                                                            <input type="number" class="form-control" id="mariageYear" min="1900" max="2024"  required>
                                                                            <small id="mariageYearMessage" class="text-danger" style="display: none;">
                                                                                L'année doit être comprise entre 1900 et l'année actuelle.
                                                                            </small>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <button type="button" class="btn btn-dark btn-sm" id="add_partner" style="margin-left: 10px">
                                                                    <i class="fas fa-plus-circle"></i>
                                                                    Ajouter
                                                                </button>
                                                            </div>
                                                            <div class="row mb-3">
                                                                <div class="col-md-6">
                                                                    <label for="nationality" class="form-label">Nationalité</label>
                                                                    <input type="text" class="form-control" id="nationality" required>
                                                                </div>
                                                                <div class="col-md-6">
                                                                    <label for="ville" class="form-label required">Ville</label>
                                                                    <input type="text" class="form-control" id="ville" required>
                                                                </div>
                                                            </div>
                                                            <div class="row mb-3">
                                                                <div class="col-md-6">
                                                                    <label for="phone" class="form-label">Téléphone</label>
