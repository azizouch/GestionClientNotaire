            $("form[name='contrat']").on("submit", function(event) {
                // Function to validate if both tables have at least one row
                function validateTables() {
                    // Check the number of rows in the first table
                    const rowsTable1 = $("#PromettantTable tbody  tr").length;
                    // Check the number of rows in the second table (replace with actual ID)
                    const rowsTable2 = $("#BeneficiaireTable tbody  tr").length; // Replace with your second table ID

                    // Ensure the tables have at least 1 row, excluding the header
                    if (rowsTable1 < 1) {
                        showAlert("Veuillez ajouter au moins une personne à la première table.");
                        return false; // Prevent form submission
                    }

                    if (rowsTable2 < 1) {
                        showAlert("Veuillez ajouter au moins une personne à la deuxième table.");
                        return false; // Prevent form submission
                    }

                    return true; // Allow form submission
                }

                // Check the table validation before submitting
                if (!validateTables()) {
                    event.preventDefault(); // Prevent form submission if validation fails
                }
