                                                    <th scope="col" class="text-capitalize">Actions</th>
                                                </tr>
                                                </thead>
                                                <tbody>
                                                <!-- Client entries will go here -->
                                                </tbody>
                                            </table>
                                        </div>
                                        <div class="card-footer">
                                            <!-- Button to Open the Modal -->
                                            <button type="button" class="btn btn-light " id="ajouterPromettant" data-bs-toggle="modal" data-bs-target="#newClientModal">
                                                <i class="fas fa-plus-circle"></i>
                                                Ajouter une ligne
                                            </button>
                                        </div>
