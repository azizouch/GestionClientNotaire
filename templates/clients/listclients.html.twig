{% extends '_base.html.twig' %}

{% block title %}Liste clients{% endblock %}

{% block body %}

    <link rel="stylesheet" href="{{ asset('asset/css/comunee.css') }}"/>

    <div class="container">
        <div class="page-inner pt-2">
            <div class="page-header m-0">
                <ul class="breadcrumbs mb-2">
                    <li class="nav-home">
                        <a href="{{ path('app_admin') }}">
                            <i class="icon-home"></i>
                        </a>
                    </li>
                    <li class="separator">
                        <i class="icon-arrow-right"></i>
                    </li>
                    <li class="nav-item">
                        <a href="#">Clients</a>
                    </li>
                    <li class="separator">
                        <i class="icon-arrow-right"></i>
                    </li>
                    <li class="nav-item">
                        <a href="#">Liste Clients</a>
                    </li>
                </ul>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <div class="d-flex align-items-center">
                                <h4 class="card-title">Clients <span class="badge bg-soft-dark text-dark ms-2">{{clients|length}}</span></h4>
                                <button class="btn btn-primary btn-round ms-auto" onclick="window.location.href='{{ path('app_add_client') }}'">
                                    <i class="fa fa-plus"></i>
                                    Nouveau
                                </button>
                            </div>
                        </div>
                        <div class="card-body pt-2">
                            <form method="GET" action="{{ path('app_clients') }}">
                                <div class="row d-flex justify-content-between">
                                    <!-- Items per Page Dropdown -->
                                    <div class="col-3 col-md-2 mb-2">
                                        <select name="itemsPerPage" id="itemsPerPage" class="form-control" onchange="this.form.submit()">
                                            <option value="10" {% if itemsPerPage == 10 %}selected{% endif %}>10</option>
                                            <option value="25" {% if itemsPerPage == 25 %}selected{% endif %}>25</option>
                                            <option value="50" {% if itemsPerPage == 50 %}selected{% endif %}>50</option>
                                            <option value="100" {% if itemsPerPage == 100 %}selected{% endif %}>100</option>
                                        </select>
                                    </div>

                                    <!-- Search Input -->
                                    <div class="col-9 col-md-6 mb-2">
                                        <input type="text" name="search" id="clientSearch" class="form-control"
                                               placeholder="Rechercher un client..." value="{{ searchQuery }}">
                                    </div>

                                    <!-- Hidden Submit Button (Not necessary but ensures form submission) -->
                                    <button type="submit" hidden></button>
                                </div>
                            </form>
                            <div class="table-responsive">
                                {% if pagination is not empty %}
                                <table id="multi-filter-select" class="table table-bordered table-hover">
                                    <thead>
                                        <tr class="head">
                                            <th style="text-transform: capitalize;">Nom</th>
                                            <th style="text-transform: capitalize;">Prenom</th>
                                            <th style="text-transform: capitalize;">Cin</th>
                                            <th style="text-transform: capitalize;">Adresse</th>
                                            <th style="text-transform: capitalize;">Situation</th>
                                            <th style="width: 10%;text-transform: capitalize;">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    {% for client in pagination %}
                                        <tr>
                                            <td>{{ client.lastName }}</td>
                                            <td>{{ client.firstName }}</td>
                                            <td>{{ client.cin }}</td>
                                            <td>{{ client.address }}</td>
                                            <td>{{ client.situation }}</td>
                                            <td>
                                                <div class="form-button-action">
                                                    <a class="btn btn-icon" href="{{ path('app_update_client', { id: client.id }) }}">
                                                        <i class="fas fa-edit fa-sm text-success"></i>
                                                    </a>
                                                    <form id="delete-client-form-{{ client.id }}" action="{{ path('app_delete_client', { id: client.id }) }}" method="POST">
                                                        <button type="button" class="btn btn-icon mx-2 delete-client-btn" data-client-id="{{ client.id }}">
                                                            <i class="fas fa-trash-alt fa-sm text-dark"></i>
                                                        </button>
                                                    </form>
                                                    <div class="card-tools">
                                                        <div class="dropdown">
                                                            <button
                                                                    class="btn btn-icon btn-clean me-0"
                                                                    type="button"
                                                                    id="dropdownMenuButton"
                                                                    data-bs-toggle="dropdown"
                                                                    aria-haspopup="true"
                                                                    aria-expanded="false"
                                                            >
                                                                <i class="fas fa-ellipsis-h"></i>
                                                            </button>
                                                            <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                                                                <a class="dropdown-item" href="{{ path('app_demande_immolog_pdf', { id: client.id }) }}" target="_blank">
                                                                    <i class="icon-printer"></i> PDF Demande du tva
                                                                </a>
                                                                <a class="dropdown-item" href="{{ path('app_engagement_pdf', { id: client.id }) }}" target="_blank">
                                                                    <i class="icon-printer"></i> PDF Engagement du tva
                                                                </a>
                                                                <a class="dropdown-item" href="#">
                                                                    Somthing else here
                                                                </a>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                                {% else %}
                                    <div class="alert-search alert_warning text-center">Aucun résultat trouvé.</div>
                                {% endif %}
                            </div>
                            <div class="row navigation d-flex justify-content-center mt-3" >
                                {{ knp_pagination_render(pagination,'@KnpPaginator/Pagination/twitter_bootstrap_v4_pagination.html.twig') }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="{{ asset('asset/js/core/jquery-3.7.1.min.js') }}"></script>

    <script>
        $(document).ready(function () {
            $(".delete-client-btn").click(function (e) {
                e.preventDefault(); // Prevent the default button action
                const clientId = $(this).data("client-id");
                const form = $("#delete-client-form-" + clientId); // Get the form associated with this button

                swal({
                    title: "Are you sure?",
                    text: "You won't be able to revert this!",
                    icon: "warning",
                    buttons: {
                        confirm: {
                            text: "Yes, delete it!",
                            className: "btn btn-danger",
                        },
                        cancel: {
                            visible: true,
                            className: "btn btn-success",
                        },
                    },
                }).then((Delete) => {
                    if (Delete) {
                        form.submit(); // Submit the form if confirmed
                    } else {
                        swal.close();
                    }
                });
            });
        });
    </script>

{% endblock %}