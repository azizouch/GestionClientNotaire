                if(personType === "personPhysique"){
                    cin = personIdentifiant.replace("CIN: ", "").trim();
                    // Create a person object to pass to the display function
                    selectedPerson = {
                        id: personId,
                        type: personType,
                        name: personName,
                        ville: personVille,
                        telephone: personTel,
                        email: personEmail,
                        identifiant: cin,
                        role: selectedRole
                    };
                }else {
                    RC = personIdentifiant.replace("RC: ", "").trim();
                    selectedPerson = {
                        id: personId,
                        type: personType,
                        name: personName,
                        ville: personVille,
                        telephone: personTel,
                        email: personEmail,
                        companyRC: RC,
                        role: selectedRole
                    };
                }


                // Check if the person already exists in either table
                if (checkPersonExists(cin)) {
                    showAlert("La personne choisie existe déjà dans l'une des tables.");
                } else {
                    // Call the function to display this person in the target table
                    if (selectedRole === "Promettant") {
                        displayPersonInTable(selectedPerson, 'PromettantTable');
                    } else if (selectedRole === "Bénéficiaire") {
                        displayPersonInTable(selectedPerson, 'BeneficiaireTable');
                    }

                    // Check if the person is already in the selected list
                    const exists = selectedPersons.some(p => p.id === personId && p.type === personType && p.role === selectedRole);
                    if (!exists) {
                        selectedPersons.push(selectedPerson); // Add the person to the array
                        $('#contrat_selectedPersons').val(JSON.stringify(selectedPersons));
                    } else {
                        console.log(`This person is already selected: ${personName}`, 'warning'); // Optional: show a warning
                    }
