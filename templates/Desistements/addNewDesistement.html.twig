                                                            <input type="number" class="form-control" id="mariageYear" min="1900" max="2024"  required>
                                                            <small id="mariageYearMessage" class="text-danger" style="display: none;">
                                                                L'année doit être comprise entre 1900 et l'année actuelle.
                                                            </small>
                                                        </div>
