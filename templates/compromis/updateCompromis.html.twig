                                    `);
                                    }else if (person.type === 'PersonMorale'){
                                        tableBody.append(`
                                        <tr data-id="${ person.id }" data-cin="${ person.cin }" data-type="personMorale">
                                            <td>${ person.name }</td>
                                            <td>RC: ${ person.RC }</td>
                                            <td>${ person.city }</td>
                                            <td>${ person.phone || '' }</td>
                                            <td>${ person.email || '' }</td>
