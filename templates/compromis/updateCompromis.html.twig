                // Retrieve data attributes
                var cin = $row.data("cin"); // Get data-cin attribute
                var ifValue = $row.data("if"); // Get data-if attribute

                // Call the function with the appropriate argument
                if (cin) {
                    deletePersonFromFieldset(cin);
                    removeFromSelectedPersons(cin);
                } else if (ifValue) {
                    deletePersonFromFieldset(ifValue);
                    removeFromSelectedPersons(ifValue)
                }

                // Remove the row from the DOM
                $row.remove();
            });
