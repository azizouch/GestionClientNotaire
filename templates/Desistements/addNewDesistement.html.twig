{% extends '_base.html.twig' %}

{% block title %}Creer nouveau desistement{% endblock %}

{% block body %}
    <style>
        .form-control{
            border: 0.5px solid lightgrey;
        }
        #newClientModal2 {
            color: #adb5bd; /* Applies white text color to all content inside the modal */
        }

        #newClientModal2 label {
            color: #adb5bd !important; /* Ensures all form labels are white */
        }

        #newClientModal2 .btn-close {
            filter: invert(100%); /* Makes the close button visible on a dark background */
        }
        #newClientModal2 .modal-body {
            max-height: 500px;
            overflow-y: auto;
        }
        #newClientModal2 .modal-header{
            border-bottom: 1px solid #adb5bd !important;
        }
        #newClientModal2 .modal-footer{
            border-top: 1px solid #adb5bd !important;
        }
        .shake {
            animation: shake 0.3s ease-in-out;
        }

        @keyframes shake {
            0% { transform: translateX(0); }
            25% { transform: translateX(-5px); }
            50% { transform: translateX(5px); }
            75% { transform: translateX(-5px); }
            100% { transform: translateX(0); }
        }
        .basetable thead th{
            text-transform: capitalize;
            background-color: #d0ece7;
        }
        #clientsTables tbody tr {
            cursor: pointer;
        }


    </style>

    <div class="container">
        <div class="page-inner pt-3">
            <div class="page-header m-0">
                <h3 class="fw-bold mb-3">Ajouter desistement</h3>
                <ul class="breadcrumbs mb-3">
                    <li class="nav-home">
                        <a href="{{ path('app_admin') }}">
                            <i class="icon-home"></i>
                        </a>
                    </li>
                    <li class="separator">
                        <i class="icon-arrow-right"></i>
                    </li>
                    <li class="nav-item">
                        <a href="#">Desistements</a>
                    </li>
                    <li class="separator">
                        <i class="icon-arrow-right"></i>
                    </li>
                    <li class="nav-item">
                        <a href="#">Créer un nouveau desistement</a>
                    </li>
                </ul>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Créer un nouveau desistement</h4>
                        </div>
                        <div class="container card-body">
                            {{ form_start(form)}}
                            <div class="row mb-3">
                                {{ form_row(form.repertoir) }}
                            </div>
                            <div class="row mb-3">
                                <fieldset class="mb-3">
                                    <legend class="col-form-label required mb-3">Designation</legend>
                                    <div id="compromis_designation">
                                        <div class="row mb-3">
                                            <div class="col-md-4">
                                                {{ form_label(form.designation.numero_bien) }}
                                                {{ form_widget(form.designation.numero_bien, { 'attr': { 'class': 'form-control shadow-sm' } }) }}
                                            </div>
                                            <div class="col-md-4">
                                                {{ form_label(form.designation.titre_foncier) }}
                                                {{ form_widget(form.designation.titre_foncier, { 'attr': { 'class': 'form-control shadow-sm' } }) }}
                                            </div>
                                            <div class="col-md-4">
                                                {{ form_label(form.designation.titre_foncier_mere) }}
                                                {{ form_widget(form.designation.titre_foncier_mere, { 'attr': { 'class': 'form-control shadow-sm' } }) }}
                                            </div>
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col-md-4">
                                                {{ form_label(form.designation.montant_TTC) }}
                                                {{ form_widget(form.designation.montant_TTC, { 'attr': { 'class': 'form-control shadow-sm' } }) }}
                                            </div>
                                            <div class="col-md-4">
                                                {{ form_label(form.designation.TVA) }}
                                                {{ form_widget(form.designation.TVA, { 'attr': { 'class': 'form-control shadow-sm' } }) }}
                                            </div>
                                            <div class="col-md-4">
                                                {{ form_label(form.designation.delai) }}
                                                {{ form_widget(form.designation.delai, { 'attr': { 'class': 'form-control shadow-sm' } }) }}
                                            </div>
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col-md-4">
                                                {{ form_label(form.designation.etage) }}
                                                {{ form_widget(form.designation.etage, { 'attr': { 'class': 'form-control shadow-sm' } }) }}
                                            </div>
                                            <div class="col-md-4">
                                                {{ form_label(form.designation.superficie) }}
                                                {{ form_widget(form.designation.superficie, { 'attr': { 'class': 'form-control shadow-sm' } }) }}
                                            </div>
                                            <div class="col-md-4">
