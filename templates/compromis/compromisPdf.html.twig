<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/html">
    <head>
        <meta charset="UTF-8">
        {% set allPersons = compromis.pmorale | merge(compromis.pphysique) %}

        {% set promettantPersons = allPersons | filter(person => 'Promettant' in person.getRoles | map(role => role.name)) %}
        {% set beneficiairePersons = allPersons | filter(person => 'Bénéficiaire' in person.getRoles | map(role => role.name)) %}

        {% set firstPromettant = promettantPersons | first %}
        {% set firstBeneficiaire = beneficiairePersons | first %}

        {% set index = 1 %}

        <title>Compromis de
            {% if firstBeneficiaire is not null %}
                {% if firstBeneficiaire.FirstName is defined and firstBeneficiaire.LastName is defined %}
                    {{ firstBeneficiaire.FirstName }} {{ firstBeneficiaire.LastName }}
                {% else %}
                    {{ firstBeneficiaire.name }}
                {% endif %}
            {% endif %}
            &
            {% if firstPromettant is not null %}
                {% if firstPromettant.FirstName is defined and firstPromettant.LastName is defined %}
                    {{ firstPromettant.FirstName }} {{ firstPromettant.LastName }}
                {% else %}
                    {{ firstPromettant.name }}
                {% endif %}
            {% endif %}
        </title>
        <style>
            body { font-family: Arial, sans-serif;line-height: 1.4; }
            strong { font-family: "Times New Roman";font-size:18px; }
            .strong2 { font-family: 'Verdana', sans-serif;font-weight: bold;font-size:16px; }
        </style>
    </head>
    <body>
        <div>
            Par-devant <strong>Maître BOUTASKIOUINE KAMAL</strong> notaire à Marrakech ( Maroc), soussigné,----
            ----------------------------------------------------------------------------------------------------------<strong class="strong2">ONT COMPARU</strong>
            <br>
            {# Display Promettant persons #}
            {% set compayName = "" %}
            {% for person in promettantPersons %}
                <strong>{{ index }}/</strong>
                {% if person.name is defined and person.name is not empty %}
                    {% set compayName = person.name %}
                    <!-- Display only the name for Personne Morale -->
                    {{ person.description }}
                {% else %}
                    MONSIEUR {{ person.FirstName|upper }} {{ person.LastName|upper }}{% if person.genre == 'Femelle' %} fille {% else %} fils {% endif %}{{ person.PrenomPere|capitalize }} et {{ person.PrenomMere|capitalize }},
                    demeurant à {{ person.address }},
                    et titulaire de la carte d'identité nationale numéro {{ person.cin }},
                    valable jusqu’au {{ person.ExpirationCin|date('d/m/Y') }},
                    De nationalité {{ person.Nationality }},
                    Né{% if person.genre == 'Femelle' %}e{% endif %} le {{ person.BirthDate|date('d/m/Y') }} à {{ person.BirthPlace }},

                    {# Display partners related to the Bénéficiaire #}
                    {% if person.partenaire is not empty %}
                        {% for partner in person.partenaire %}
                            Marié{% if person.genre == 'Femelle' %}e{% endif %} avec {{ partner.FirstName }} {{ partner.LastName }} en {{ partner.MariageYear }} à {{ partner.MariagePlace }}.
                        {% endfor %}
                    {% endif %}
                {% endif %}
                <br>
                {% set index = index + 1 %} {# Increment index #}
            {% endfor %}
            -----------------------------------------------------------------<strong>Ci-après dénommé les Promettantses qualite</strong>

            ---------------------------------------------------------------------------------------------------------------<strong class="strong2">D'UNE PART</strong>
            <br>
            {# Display Bénéficiaire persons #}
            {% set countBenificiaires = 0 %}
            {% for person in beneficiairePersons %}
                {% set countBenificiaires = countBenificiaires + 1 %}
                <strong>{{ index }}/</strong>
                {% if person.name is defined %}
                    {{ person.name }}
                {% else %}
                    <strong>{{ person.Civilite }} {{ person.FirstName|upper }} {{ person.LastName|upper }}</strong>{% if person.genre == 'Femelle' %} fille {% else %} fils {% endif %}{{ person.PrenomPere|capitalize }} ET {{ person.PrenomMere|capitalize }},
                    demeurant à {{ person.address }},
                    et titulaire de la carte d'identité nationale numéro {{ person.cin }},
                    valable jusqu’au {{ person.ExpirationCin|date('d/m/Y') }},
                    De nationalité {{ person.Nationality }},
                    Né{% if person.genre == 'Femelle' %}e{% endif %} le {{ person.BirthDate|date('d/m/Y') }} à {{ person.BirthPlace }},

                    {# Display partners related to the Bénéficiaire #}
                    {% if person.partenaire is not empty %}
                        {% for partner in person.partenaire %}
                            Marié{% if person.genre == 'Femelle' %}e{% endif %} avec {{ partner.FirstName }} {{ partner.LastName }} en {{ partner.MariageYear }} à {{ partner.MariagePlace }}.
                        {% endfor %}
                    {% endif %}
                {% endif %}
                <br>
                {% set index = index + 1 %} {# Increment index #}
            {% endfor %}

            ------------------------------------------------------------------------------<strong>Ci-après dénommé {% if countBenificiaires > 1 %} les Bénéficiaires {% else %} le Bénéficiaire {% endif %}</strong>
            <br>
            -----------------------------------------------------------------------------------------------------------<strong class="strong2">D'AUTRE PART</strong>
            <br>
            Les Promettantses qualité et le Bénéficiaire sont ci-après collectivement désignés les "Parties" et individuellement la "Partie". -------------------------------------------------------------------------------------------
            <br>
            Lesquels, ont requis <strong>Maître BOUTASKIOUINE Kamal</strong> notaire soussigné de constater par acte authentique, Lesquels, parties, ont, d’un

            commun accord entre eux, requis <strong>Maître BOUTASKIOUINE Kamal</strong>, Notaire soussigné, de rédiger en langue française, conformément à

            l’article 42 de la loi n°32-09 relative à l’organisation de la profession de Notaire et de conférer l’authenticité aux conventions

            suivantes directement arrêtées entre eux sans le concours ni la participation dudit notaire, qui n’en est que le rédacteur,

            conformément à l’article 35 de la loi 32-09 susmentionnée. Sachant que le Notaire, reçoit les actes, auxquels la loi impose le

            caractère d’authenticité attachée aux actes de l’autorité publique, ou auxquels les parties veulent donner ce caractère.

            Le Notaire constate la date des actes et assure la conservation des minutes et en délivre des exemplaires et copies. ----------------------------------------------------------------------------------
            <br>
            <strong>IL a été, préalablement aux présentes, exposé ce qui suit:</strong> ----------------------------------------------
            <br>
            Que le présent compromis de vente s’inscrit dans le cadre des dispositions de l’article 93 du code général des impôt telle qu’il

            a été modifié et complété par la loi de finances pour l’année 2010 relatives aux opérations de cession de logements sociaux à

            usage d’habitation principale, prévoyant notamment le paiement par l’Etat au bénéfice de la Bénéficiaire, de la partie du prix

            de vente égale au montant de la TVA, grevant l’acquisition de logements sociaux. ------------------------
            <br>
            <strong>Ceci exposé, il a été arrêté et convenu ce  qui suit :</strong> --------------------------------------------------------
            <br>
            <strong class="strong2">ARTICLE 1 - COMPROMIS DE VENTE DE BIEN IMMOBILIER SOUMIS AU REGIME DE LA COPROPRIETE DANS LE CADRE DES DISPOSITIONS DE LA LOI DE

                FINANCES POUR L’ANNEE 2010 SUR LE LOGEMENT SOCIAL</strong> ----------------------------------------------------------------
            <br>
            La société « <strong>{{ compayName }}</strong> » SARL, représentée par ses mandataires dûment habilités à cet effet, comparants d’une part, s’engagent à

            vendre par les présentes, en s’obligeant à toutes les garanties ordinaires de fait et de droit, les plus étendues en pareille

            matière. --------------------------
            <br>A
            {% for person in beneficiairePersons %}
                {% if person.name is defined %}
                    {{ person.name }}
                {% else %}
                    <strong>{{ person.Civilite|upper }} {{ person.FirstName|upper }} {{ person.LastName|upper }}</strong>
                {% endif %}

                {% if not loop.last %} et {% endif %}
            {% endfor %}

            {% if countBenificiaires > 1 %}
                comparants
            {% else %}
                {% set firstBeneficiaire = beneficiairePersons|first %}
                comparant{% if firstBeneficiaire and firstBeneficiaire.genre == "Femelle" %}e{% endif %}
            {% endif %}

            d’autre part, ici présents et qui acceptent, d’acquérir par parts égales entre eux dans l’indivision a conccurence de 50% chacun   DANS LA propriété des biens immobiliers désignés.--------------------
            <br>
            -------------------------------------------<strong class="strong2">ARTICLE 2 - DESIGNATION</strong>-----------------------------------------------
            <br>
            La totalité de la propriété sise à {{ compromis.designation.adresse }},  consistant en un appartement en

            copropriété, situé au <strong>{{ compromis.designation.etage }}</strong>, d’une superficie de: <strong>{{ compromis.designation.superficie }}</strong> m2 SOIXANTE DIX NEUF METRE CARRES,  constituant la fraction divise

            numéro <strong>{{ compromis.designation.NumeroDivise }}</strong>, immatriculée à la conservation foncière de Marrakech sous la dénomination de «<strong>{{ compromis.designation.NumeroBien }}</strong>» objet du titre

            foncier <strong>N°{{ compromis.designation.TitreFoncier }}</strong> -----------------------------------------------------
            <br>
            Les parts d’indivision <strong>{{ compromis.designation.indivision }}</strong> dans l’immeuble et les <strong>{{ compromis.designation.residence }}</strong> dans la résidence affectées à cet appartement

                dans le règlement de copropriété de l’immeuble objet du titre foncier mère <strong>N°{{ compromis.designation.TitreFoncierMere }}</strong> ----------------------------------------------------------------------------------------------------
            <br>
            Tel au surplus que le Bien existe et se comporte avec toute ses aisances et dépendances et tous les droits y attachés sans

            aucune exception ni réserve, et tel en outre, qu'il est bien connu de la Bénéficiaire qui déclare l'avoir vu et visité à

            plusieurs reprises aux fins des présentes. ----------------
            <br>
            ----------------------------------------<strong class="strong2">ARTICLE 3 - ORIGINE DE PROPRIETE</strong>------------------------------------
            <br>
            Pour les besoins du Service de l’Enregistrement « le vendeur es qualités » déclare qu’il est propriétaire du bien présentement

            vendu tel qu’il est mentionné   a conservation foncière.

            --------------------------------------<strong class="strong2">ARTICLE 4 - PROPRIETE  - JOUISSANCE</strong>----------------------------------
            <br>
            Le Bénéficiaire sera propriétaire du Bien à compter du jour de l’inscription de l’acte de vente définitif sur les livres fonciers conformément

            aux dispositions des articles 66 et 67 du Dahir du 12 Août 1913 relatif à l'immatriculation des immeubles tel qu’il a été modifié et complété

            par la loi  numéro 14-07. Néanmoins, il n’en aura la jouissance par la prise de possession réelle à  son profit, libre de toute occupation,

            location ou domiciliation quelconque, qu’à compter du jour de la signature de l’acte de vente définitif et de l’encaissement effectif par

            les promettants es qualité de l’intégralité du prix de vente.-------------------------------------------------------------------------------------------
            <br>
            ---------------------------------------<strong class="strong2">ARTICLE 5 - CHARGES & CONDITIONS</strong>----------------------------------
            <br>
            Le présent compromis est fait sous les charges et conditions ordinaires de fait et de droit, les plus étendues en pareille matière et notamment sous celles

            suivantes que la Bénéficiaires qualités ‘oblige à exécuter et accomplir, savoir :-----------------------------------------------------------------------------
            <br>
            a) de prendre le Bien dans l’état où il se trouve actuellement, sans pouvoir prétendre à aucune indemnité ni diminution du

            prix ci-après fixé pour quelque cause que ce soit. ---------------------------
            <br>
            b) de souffrir les servitudes passives, apparentes ou occultes, continues ou discontinues et mitoyennetés, dont le Bien,

            peut être grevé sauf à s’en défendre et à profiter en retour de celles actives, s’il en existe à ses risques et périls. ----------------------------------------------------------------------
            <br>
            A ce sujet, les Promettant ses qualité déclarent qu’à sa connaissance ils n’existent pas d’hypothèques, charges, servitudes,

            ni mitoyennetés grevant le Bien autres que celles figurant au dossier d’immatriculation du Bien que la Bénéficiaire déclare bien connaître.----------------------------
            <br>
            c) d’acquitter à compter du jour ci-dessus fixé pour l’entrée en jouissance, toutes contributions, impositions ou autres taxes,

            généralement quelconque pouvant grever le Bien de manière que les Promettant ses qualité  ne soit jamais inquiété ni recherché à ce sujet.------------------------------------
            <br>
            Etant bien entendu que pour les périodes antérieures à la date d'entrée en jouissance du Bénéficiaire tous impôts, taxes et contributions

            quelconques émis ou restant à émettre et non encore réglés à ce jour, resteront entièrement à la charge exclusive les Promettant ses qualité

            qui s'y obligent expressément.-----------------------------------------------------------------------------------------------
            <br>
            d) de se conformer aux clauses, conditions, prescriptions et interdictions résultant du règlement de copropriété afférent à l'immeuble dont

            dépend le Bien, ainsi qu'aux obligations incombant aux membres du syndicat des copropriétaires dudit immeuble. -----------------------------------------------------
            <br>
            e) de payer tous les droits, frais et taxes des présentes et ceux qui en seront la suite ou la conséquence. ---------------------------------------------------------------------------------------------------------------
            <br>
            -----------------------------------------<strong class="strong2">ARTICLE  6 -  PRIX DE LA VENTE</strong>--------------------------------------------
            <br>
            La vente définitive sera faite moyennant le prix de DEUX CENT QUATRE-VINGT DIX SEPT MILLE  TROIS CENT QUARANTE DIRHAMS ET SOIXANTE DIX CENTIMES (297 340,70 DHS),

            y compris la taxe sur la valeur ajoutée, s'appliquant comme suit: -----------------------------------------------
            <br>
            - A concurrence de la somme de DEUX CENT CINQUANTE MILLE DIRHAMS (250 000,00DHS), représentant le prix de vente hors taxe sur la valeur ajoutée. --------------------------------------------------
            <br>
            - A concurrence de la somme de QUARANTE-SEPT MILLE TROIS CENT QUARANTE DIRHAMS ET SOIXANTE DIX CENTIMES (47 340,70 DHS), représentant le montant

            de la Lequel prix sera payé par les Bénéficiaires entre les mains du notaire soussigné, au plus tard le jour convenu ci-après pour la réalisation

            de la condition suspensive ci-dessous citée. --------------------------------------
            <br>
            Etant  précisé, que la Bénéficiaire es qualité entend bénéficier du versement par l’Etat, à son bénéfice, de la partie du prix de vente égale au

            montant de la taxe sur la valeur ajoutée, grevant l’acquisition du Bien, conformément aux dispositions de l’article 93 du code général des impôts

            tel que modifié et complété par la loi de finances pour l’année 2010. --------------------------------------------
            <br>
            Dans le cas où la Bénéficiaire es qualité ne bénéficie pas de ce versement par l'Etat, à son bénéfice, de la partie du prix de vente égale au  montant

            de la taxe sur la valeur ajoutée, il s'oblige à payer en sus du prix de vente hors taxe sur la valeur ajoutée, tous les impôts et taxes dus par le vendeur

            es qualité  pour cette vente et desquels il était exonéré en vertu de la convention qu'il a signée avec l'Etat.----------------------------------------------------------------------------------------------------------
            <br>
            ---------------------------------------<strong class="strong2">ARTICLE 7 - CONDITION SUSPENSIVE</strong>------------------------------------
            <br>
            Le présent compromis de vente est soumis aux conditions suspensives suivantes (i) Du paiement par la Bénéficiaire es qualité aux Promettant ses qualités,

            de l'intégralité du prix de vente y compris la taxe sur la valeur ajoutée, comme suit: ---------------------------------------------------------------------------
            <br>
            - A concurrence de la somme de DEUX CENT CINQUANTE MILLE DIRHAMS (250 000,00DHS) représentant le prix de vente hors taxe sur la valeur ajoutée, qui sera

            payé par des deniers personnels de l’acquéreur-----------------------------------------------------------------------------------------------
            <br>
            Et à concurrence de la somme de QUARANTE-SEPT MILLE TROIS CENT QUARANTE DIRHAMS ET SOIXANTE DIX CENTIMES (47 340,70 DHS),représentant le montant de

            la taxe sur la valeur ajoutée par le versement par l'Etat, entre les mains du notaire soussigné, au bénéfice de Bénéficiaire, de la partie du prix de

            vente égale au montant de la taxe sur la valeur ajoutée, grevant l’acquisition du Bien, conformément aux dispositions de l’article 93 du code général

            des impôts tel que modifié et complété par la loi de finances pour l’année 2010. --------------------------------------------
            <br>
            Toutefois, dans le cas où la Bénéficiaire ne bénéficie pas de ce versement par l'Etat, à son bénéfice, de la partie du prix de vente égale au  montant

            de la taxe sur la valeur ajoutée, il s'oblige à payer en sus du prix de vente hors taxe sur la valeur ajoutée, tous les impôts et taxes dûs par les Promettantes

            qualité pour cette vente et desquels il était exonéré en vertu de la convention qu'ils ont signée avec l'Etat

            (ii) l’obtention par les promettants es qualité du permis d’habiter relatif au Bien. ---------------------------------------------------------------------------------------------------------------------------
            <br>
            Le tout au plus tard dans un délai de QUATRE VINGT DIX (90) jours, à compter de la date de signature du présent compromis.--------------------------------------------------------------------------------------
            <br>
            Passé ce délai de QUATRE VIGNT DIX (90) jours et à défaut de réalisation de la première condition suspensive visé au paragraphe (i) ci-dessus malgré

            la réalisation de la seconde condition suspensive, les promettants es qualité se réservent le droit si bon leur semble, de se délièrent de leurs engagements

            sans qu’il soit besoin d’être constaté par un acte ultérieur et le présent compromis sera considéré comme étant nul et non avenu, avec application des stipulations

            de l'article 8 ci-après.---------------------------------------------------------------------------------------------------------
            <br>
            -------------------------------------------------<strong class="strong2">ARTICLE 8 – INDEMNITES</strong>-------------------------------------------
            <br>
            En cas de non réalisation de l'acte définitif de vente notamment pour (i) non réalisation de la condition suspensive sus visée dans le délai ci-dessus convenu,

            (ii) renonciation ou désistement de bénéficiaire, ce dernier s’oblige expressément à régler au profit des promettants es qualité, une indemnité fixée d’un commun

            accord à dix  pour cent (10 %) du prix de vente sus visé, que la bénéficiaire autorise les promettant es qualité, à l’instant même, de façon irrévocable et automatique,

            à prélever des versements effectués aux promettants es qualité et ce, à titre d’indemnité d’immobilisation et dommages - intérêts et en contrepartie du préjudice subi,

            et renonce d’ores et déjà à toute réclamation ou contestation à ce sujet. --------------------------------------
            <br>
            ----------------------<strong class="strong2">ARTICLE 9 – DECLARATIONS – GARANTIES ET ENGAGEMENTS</strong>----------------
            <br>
            Le Bénéficiaire déclare et garantit--------------------------------------------------------------------------------------
            <br>
            - qu’il jouit de tous ses droits civiques et qu’il  a pleine capacité pour conclure les présentes et exécuter les obligations qui lui incombent au titre du présent

            compromis de vente.----------------------
            <br>
            Le Bénéficiaire s'engage à :----------------------------------------------------------------------------------------------
            <br>
            Affecter le Bien à son habitation principale pendant une durée de quatre (4) années consécutives, à compter de la date de conclusion du contrat d’acquisition définitif. ----------------------------------------
            <br>
            Consentir au profit de l’Etat, une hypothèque de premier ou deuxième rang sur le Bien, en garantie de la taxe sur la valeur ajoutée versée par l’Etat, ainsi que des pénalités et majorations exigibles,

            en cas de manquement à l’engagement visé au paragraphe précédent. -----------------------------------
            <br>
            les Promettants es qualité déclarent et garantit :-------------------------------------------------------------------
            <br>
            - Qu'ils ont conclu une convention avec l'Etat pour la réalisation d'un programme de construction d'au moins cinq cent (500) logements sociaux, réparti sur une

            période maximum de cinq (5) ans, dans les conditions prévues à l'article 247-XVI du code général des impôts.------------------------------
            <br>
            - Que le Bien a fait l’objet d’un permis d’habiter délivré par la commune urbaine de Marrakech. ----
            <br>
            - Que le Bien sera le jour de la signature du contrat définitif de vente libre de toutes dettes ou charges et qu'il ne fera l'objet d'aucune mesure conservatoire exécutoire.--------------------------------
            <br>
            Si contrairement aux déclarations qui précèdent, le Bien serait grevé d'une ou plusieurs inscriptions, saisies ou autres charges du chef du Vendeur, ce dernier s'oblige à en

            rapporter à ses frais la justification de leur radiation le jour de la réalisation de l'acte définitif de vente.----------------
            <br>
            --------------------------------------<strong class="strong2">ARTICLE 10 - DECLARATION ETAT CIVIL</strong>--------------------------------
            <br>
            Les vendeurs es qualités déclarent formellement, que les biens ci-dessus désignés sont libres de toutes dettes et charges et qu’ils ne font l’objet d’aucune .-----------------------------------------------------
            <br>
            Si, contrairement à cette déclaration, ladite propriété était grevée d’une ou plusieurs inscriptions du chef des vendeurs préalablement à l’inscription des présentes sur les livres fonciers,

            et en tout cas dans le mois de la dénonciation amiable qui lui en sera faite au domicile ci-après élu. ----------------
            <br>
            En conséquence, il ne peut être procédé  à l’inscription de la présente vente qu’après radiation de toutes les charges grevant ou pouvant grever l’immeuble vendu. -------------------------------------------
            <br>
            L’acquéreur es qualité déclare avoir connaissance des hypothèques cites ci-dessus il donne des charge au notaire de toute responsabilité en cas du retard pour la signature de la vente

            définitive ou  à l’inscription a la conservation foncier ------------------------------------------------------------------------
            <br>
            -------------------------<strong class="strong2">ARTICLE 11 - ELECTION DE DOMICILE – NOTIFICATIONS</strong>----------------------
            <br>
            Pour l'exécution des présentes et de leurs suites, les Parties font élection de domicile en leur siège et demeure respectif sus indiqué.-------------------------------------------------------------------------------------
            <br>
            Toute notification devant être faite en vertu de l’une ou l’autre des stipulations du présent contrat, sauf stipulation expresse à l’effet contraire, sera valablement effectuée si elle est envoyée,

            par lettre recommandée avec avis de réception et adressée au domicile ci-dessus élu.--------------------
            <br>
            Chacune des Parties devra, à peine d’inopposabilité, aviser chacune des autres Parties de tout changement d’adresses postales.------------------------------------------------------------------------------------
            <br>
            -----------------------------------------------<strong class="strong2">ARTICLE 12 – DIVERS</strong>--------------------------------------------------
            <br>
            Le défaut d’une ou l’autre des Parties d’insister sur la stricte exécution d’une obligation au titre du présent contrat, ou d’exercer toute option ou tout droit ne devra pas être

            interprété comme une renonciation au bénéfice du terme, de la stipulation, de l’option ou du droit concerné, et ceux-ci continueront de recevoir plein effet. Toute renonciation

            au bénéfice de l’une quelconque des stipulations du présent contrat n’engagera la Partie concernée que pour autant que cette renonciation ait été exprimée par écrit. ----------------------------------------------------------------------------
            <br>
            Dans l’hypothèse où l’une ou plusieurs des stipulations du présent contrat seraient jugées nulles ou inapplicables pour quelque raison que ce soit, toute autre stipulation du

            présent contrat n’en serait aucunement affectée ou altérée et la validité ou l’exécution de la ou des stipulations concernées ne serait pas remise en cause dans tout autre

            situation ou devant toute autre juridiction.------------------------------------------------------------------------------------------------------------------
            <br>
            -----------------<strong class="strong2">ARTICLE 13 – ETABLISSEMENT DE L'ACTE DE VENTE DEFINITIF</strong>-----------------
            <br>
            Les Parties décident d'un commun accord, que le contrat définitif de vente sera établi, en la forme notariée, par-devant le notaire soussigné, après règlement par Le Bénéficiaire

            de l'intégralité du prix d'acquisition toutes taxes comprises et des frais qui en résulte.---------------------------------------
            <br>
            -----<strong class="strong2">ARTICLE 14 - LECTURE DE L’ACTE ET PRISE DE CONNAISSANCE DE SA TENEUR</strong>-----
            <br>
            Par les présentes, les Parties déclarent avoir lu le présent acte et pris connaissance de sa teneur notamment par la lecture qui leur a été faite par le notaire soussigné et

            reconnaissent avoir parfaitement compris la teneur des présentes qu'elles approuvent sans réserve.-----------------------
            <br>
            ---------------------------------------------------------------------------------------------------------------<strong class="strong2">DONT ACTE</strong>
            <br>
            <strong>FAIT ET PASSE A Marrakech</strong>, ----------------------------------------------------------------------------------
            <br>
            <strong>EN L'ETUDE DE Maitre BOUTASKIOUINE KAMAL</strong> ------------------------------------------------
            <br>
            <strong>L’an Deux Mille vingt-quatre</strong>,--------------------------------------------------------------------------------------
            <br>
            <strong>Et après lecture faite, les Parties ont signé avec le notaire soussigné</strong>.--------------------------------
            <br><br><br><br><br><br><br><br><br><br>
            <table style="width: 100%; border-collapse: collapse; font-family: Arial, sans-serif;">
                <thead>
                <tr>
                    <th style="border: 1px solid #000; padding: 8px; text-align: center; width: 36%;">&nbsp;</th>
                    <th style="border: 1px solid #000; padding: 8px; text-align: center; width: 32%;"><u>DATE ET HEURES</u></th>
                    <th style="border: 1px solid #000; padding: 8px; text-align: center; width: 32%;"><u>SIGNATURE</u></th>
                </tr>
                </thead>
                <tbody>
                <tr>
                    <td style="height: 100px; border: 1px solid #000; padding: 8px; text-align: center; font-family: 'Times New Roman'"><strong style="font-size: 18px;">Le promettant es-qualité : <br>Monsieur SAID AOURAGH</strong></td>
                    <td style="border: 1px solid #000; padding: 8px; text-align: center;"></td>
                    <td style="border: 1px solid #000; padding: 8px; text-align: center;"></td>
                </tr>
                {% for person in beneficiairePersons %}
                    {% if person.name is defined %}
                        {{ person.name }}
                    {% else %}
