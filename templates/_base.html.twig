                } else {
                    window.location.href = "{{ path('search_client') }}?query=" + encodeURIComponent(searchValue);
                }
            });
            document.addEventListener("DOMContentLoaded", function () {
                const scrollTopBtn = document.getElementById("scrollTopBtn");

                window.addEventListener("scroll", function () {
                    if (window.scrollY > 200) {
                        scrollTopBtn.style.display = "flex";
                    } else {
                        scrollTopBtn.style.display = "none";
                    }
                });
                if (window.scrollY > 200) {
                    scrollTopBtn.style.display = "flex";
                } else {
                    scrollTopBtn.style.display = "none";
                }

                scrollTopBtn.addEventListener("click", function () {
                    window.scrollTo({
                        top: 0,
                        behavior: "smooth"
                    });
                });
            });


            // Select the dropdown menu and button elements
            const dropdownMenu = document.querySelector('#dropdownMenuButton + .dropdown-menu');
            const langLabel = document.querySelector('#lang_label');
            document.addEventListener("DOMContentLoaded", () => {
                const formOutlines = document.querySelectorAll(".form-outline");

                formOutlines.forEach((outline) => {
                    const input = outline.querySelector(".form-control");
                    const label = outline.querySelector(".form-label");
                    const notchMiddle = outline.querySelector(".form-notch-middle");
                    const notchLeading = outline.querySelector(".form-notch-leading");

                    const adjustNotch = () => {
                        if (label && notchMiddle && notchLeading) {
                            const labelWidth = label.offsetWidth * 0.8 + 8; // Calculate based on label width
                            const labelMarginLeft = parseFloat(getComputedStyle(label).marginLeft) || 0;

                            notchMiddle.style.width = `${labelWidth}px`; // Set middle notch width
                            notchLeading.style.width = `${labelMarginLeft + 9}px`; // Set leading notch width
                        }
                    };

                    // Adjust on focus, blur, and page load
                    input.addEventListener("focus", adjustNotch);
                    input.addEventListener("blur", adjustNotch);
                    adjustNotch(); // Adjust on page load
                });
            });

            document.addEventListener('DOMContentLoaded', function() {
                const registerModal = new bootstrap.Modal(document.getElementById('registerModal'), {
                    backdrop: 'static',
                    keyboard: false
                });

                const form = document.querySelector('form[name="registration_form"]');
                const passwordInput = document.getElementById('registration_form_plainPassword');
                const confirmPasswordInput = document.getElementById('registration_form_repeatPassword');
                const errorMessage = document.getElementById('error-message');

                form.addEventListener('submit', function(event) {
                    if (passwordInput.value !== confirmPasswordInput.value) {
                        event.preventDefault(); // Prevent form submission
                        confirmPasswordInput.classList.add('error'); // Add error class and vibration effect
                        errorMessage.style.display = 'block'; // Show the error message
                        confirmPasswordInput.focus(); // Focus on the confirmation password field

                        // Remove the error classes and message after a brief moment for further corrections
                        setTimeout(() => {
                            confirmPasswordInput.classList.remove('error');
                            errorMessage.style.display = 'none'; // Hide the error message
                        }, 2000); // Change this value to control how long the error is shown
                    }
                });

            });

            // Add a click event listener to the dropdown menu for languages
            dropdownMenu.addEventListener('click', function (event) {
                // Check if a dropdown item was clicked
                if (event.target.classList.contains('dropdown-item')) {
                    event.preventDefault(); // Prevent default link behavior
                    const selectedLang = event.target.getAttribute('data-lang'); // Get the selected language
                    langLabel.textContent = selectedLang; // Update the lang_label span text
                }
            });

            document.addEventListener("DOMContentLoaded", function () {
                const currentPath = window.location.pathname; // Get the current URL path
                const navLinks = document.querySelectorAll(".nav-item .nav-collapse a"); // Target nested links

                navLinks.forEach(link => {
                    if (link.getAttribute("href") === currentPath) {
                        // Add 'active' class to the link
                        link.classList.add("active");

                        // Ensure the parent submenu is expanded
                        const parentSubmenu = link.closest(".collapse");
                        if (parentSubmenu) {
                            parentSubmenu.classList.add("show");

                            // Add 'active' class to the parent <li>
                            const parentNavItem = parentSubmenu.closest(".nav-item");
                            parentNavItem.classList.add("submenu");
                            if (parentNavItem) {
                                parentNavItem.querySelector("a[data-bs-toggle]").classList.add("active");
                            }
                        }
                    }
                });
            });

            // Wait for the page to fully load
            window.addEventListener('load', () => {
                const loader = document.getElementById('loader');
                // After 2 seconds, hide the loader and show the content
                setTimeout(() => {
                    loader.style.display = 'none';   // Hide the loader
                }, 20);
            });

            //chat js
            $(document).ready(function () {
                // Show the modal when the button is clicked
                $('#openModalBtn').on('click', function () {
                    $('#chatModal').modal('show');
                });

                // Close the modal when the close button is clicked
                $('#closeModalBtn').on('click', function () {
                    $('#chatModal').modal('hide');
                });

                // Handle user selection
                $('.user-message').on('click', function () {
                    const username = $(this).data('username');
                    $('#modalUserName').text(username);
                    $('.user-list').hide();
                    $('.chat-box').removeClass('d-none');

                    // Example messages for the selected user
                    $('.messages').html(`
                        <div class="message received">Hi! How can I help you?</div>
                        <div class="message sent">Hello!</div>
                        <div class="message received">What are you looking for?</div>
                    `);
                });

                // Handle sending messages
                $('#sendMessageBtn').on('click', function () {
                    const input = $('#chatInput');
                    const message = input.val().trim();
                    if (message) {
                        const messageElement = $('<div class="message sent"></div>').text(message);
                        $('.messages').append(messageElement);
                        input.val(''); // Clear the input
                        $('.chat-box').scrollTop($('.chat-box')[0].scrollHeight); // Scroll to the bottom
                    }
                });

                // Optionally, you can handle pressing Enter to send a message
                $('#chatInput').on('keypress', function (event) {
                    if (event.key === 'Enter') {
                        $('#sendMessageBtn').click();
                    }
                });

            });
            // end chat js

            $("#lineChart").sparkline([102, 109, 120, 99, 110, 105, 115], {
                type: "line",
