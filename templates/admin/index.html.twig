            var recents = $('.recents .scrollbar');

            if (recents.length > 0) {
                recents.scrollbar();
            }
        });
        $.ajax({
            url: '/api/statistics', // Correct URL
            type: 'GET', // Use 'GET' method to fetch data
            dataType: 'json', // Expect JSON response
            success: function(response) {
                console.log(response); // Log response for debugging
                statisticsChart.data.datasets[0].data = response.desistements; // Update Desistements
                statisticsChart.data.datasets[1].data = response.procurations; // Update Procurations
                statisticsChart.data.datasets[2].data = response.compromis; // Update Compromis
                statisticsChart.update(); // Update the chart
            },
            error: function(error) {
                console.error('Error fetching statistics:', error);
            }
        });
    </script>
