{% extends '_base.html.twig' %}

{% block title %}Liste procurations{% endblock %}

{% block body %}

    <link rel="stylesheet" href="{{ asset('asset/css/comunee.css') }}"/>

    <div class="container">
        <div class="page-inner pt-2">
            <div class="page-header m-0">
                <ul class="breadcrumbs mb-2">
                    <li class="nav-home">
                        <a href="{{ path('app_admin') }}">
                            <i class="icon-home"></i>
                        </a>
                    </li>
                    <li class="separator">
                        <i class="icon-arrow-right"></i>
                    </li>
                    <li class="nav-item">
                        <a href="#">Procurations</a>
                    </li>
                    <li class="separator">
                        <i class="icon-arrow-right"></i>
                    </li>
                    <li class="nav-item">
                        <a href="#">Liste procurations</a>
                    </li>
                </ul>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <div class="d-flex align-items-center">
                                <h4 class="card-title">Procurations <span class="badge bg-soft-dark text-dark ms-2">{{procurations|length}}</span></h4>
                                <button class="btn btn-primary btn-round ms-auto" onclick="window.location.href='{{ path('app_add_new_procuration') }}'">
                                    <i class="fa fa-plus"></i>
                                    Nouveau
                                </button>
                            </div>
                        </div>
                        <div class="card-body">
                            <form method="GET" action="{{ path('app_procurations') }}">
                                <div class="row d-flex justify-content-between">
                                    <!-- Items per Page Dropdown -->
                                    <div class="col-3 col-md-2 mb-2">
                                        <select name="itemsPerPage" id="itemsPerPage" class="form-control" onchange="this.form.submit()">
                                            <option value="10" {% if itemsPerPage == 10 %}selected{% endif %}>10</option>
                                            <option value="25" {% if itemsPerPage == 25 %}selected{% endif %}>25</option>
                                            <option value="50" {% if itemsPerPage == 50 %}selected{% endif %}>50</option>
                                            <option value="100" {% if itemsPerPage == 100 %}selected{% endif %}>100</option>
                                        </select>
                                    </div>

                                    <!-- Search Input -->
                                    <div class="col-9 col-md-6 mb-2">
                                        <input type="text" name="search" id="procurationSearch" class="form-control"
                                               placeholder="Rechercher un client..." value="{{ searchQuery }}">
                                    </div>

                                    <!-- Hidden Submit Button (Not necessary but ensures form submission) -->
                                    <button type="submit" hidden></button>
                                </div>
                            </form>
                            <div class="table-responsive">
                                {% if pagination is not empty %}
                                <table class="table table-hover table-bordered">
                                    <thead>
                                    <tr>
                                        <th>Repertoire</th>
                                        <th>1ere partie(S)</th>
                                        <th>2eme partie(S)</th>
                                        <th>Statut</th>
                                        <th style="width: 10%">Action</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for procuration in pagination %}
                                        <tr class="procuration-row" data-id="{{ procuration.id }}">
                                            <td>{{ procuration.repertoir }}</td>
                                            <td>
                                                {# Mandants #}
                                                {% for person in procuration.persons %}
                                                    {% for role in person.getRoles %}
                                                        {% if role.name == 'Mandant' %}
                                                            <span class="badge bg-soft-dark text-dark ms-1 fw-bold text-uppercase" style="font-size: 12px"> {{ person.FirstName }} {{ person.LastName }} </span> {# Replace 'name' with the property for the person's name #}
                                                        {% endif %}
                                                    {% endfor %}
                                                {% endfor %}
                                            </td>
                                            <td>
                                                {# Mandataires #}
                                                {% for person in procuration.persons %}
                                                    {% for role in person.getRoles %}
                                                        {% if role.name == 'Mandataire' %}
                                                            <span class="badge bg-soft-dark text-dark ms-1 fw-bold text-uppercase" style="font-size: 12px"> {{ person.FirstName }} {{ person.LastName }} </span>
                                                        {% endif %}
                                                    {% endfor %}
                                                {% endfor %}
                                            </td>
                                            <td>
                                                <span class="badge bg-soft-success text-success border-0" style="font-size: 11px">active</span>
                                            </td>
                                            <td>
                                                <div class="dropdown">
                                                    <button class="btn btn-label-info btn-round btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                        <small class="btn-label"><i class="fa fa-print"></i></small>Print
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-end">
                                                        <li><a class="dropdown-item" href="{{ path('app_procuration_pdf', { id: procuration.id }) }}" target="_blank"><i class="fa fa-file-pdf"></i> Pdf</a></li>
                                                        <li><a class="dropdown-item" href="{{ path('app_procuration_pdf_eng', { id: procuration.id }) }}" target="_blank"><i class="fa fa-file-pdf"></i> Pdf Eng</a></li>
                                                        <li><a class="dropdown-item" href="{{ path('app_procuration_word', { id: procuration.id }) }}" target="_blank"><i class="fa fa-file-word"></i> Word</a></li>
{#                                                        <li><a class="dropdown-item" href="{{ path('app_procuration_word_eng', { id: procuration.id }) }}" target="_blank"><i class="fa fa-file-word"></i> Word Eng</a></li>#}
                                                    </ul>
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                                {% else %}
                                    <div class="alert-search alert_warning text-center">Aucun résultat trouvé.</div>
                                {% endif %}
                            </div>
                            <div class="row navigation d-flex justify-content-center mt-3" >
                                {{ knp_pagination_render(pagination,'@KnpPaginator/Pagination/twitter_bootstrap_v4_pagination.html.twig') }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="{{ asset('asset/js/core/jquery-3.7.1.min.js') }}"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {

            document.querySelectorAll(".procuration-row").forEach(row => {
                // Handle row click (navigate to the update page)
                row.addEventListener("click", function(event) {
                    // Check if the clicked element is not inside the last dropdown cell
                    const dropdownCell = row.querySelector("td:last-child");
                    if (!dropdownCell.contains(event.target)) {
                        let procurationId = this.getAttribute("data-id");
                        if (procurationId) {
                            console.log("Navigating to: /procuration/update/" + procurationId);
                            window.location.href = "/procuration/update/" + procurationId; // Change this URL based on your Symfony route
                        }
                    }
                });

                // Add click event listener to the dropdown button (dropdown toggle)
                const dropdownButton = row.querySelector(".dropdown-toggle");
                if (dropdownButton) {
                    dropdownButton.addEventListener("click", function(event) {
                        event.stopPropagation(); // Prevent the row click from firing
                        event.preventDefault(); // Prevent any default behavior associated with the button
                    });
                }
            });
        });
    </script>

{% endblock %}