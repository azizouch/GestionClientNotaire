{% extends '_base.html.twig' %}

{% block title %}Kaiadmin | Dashboard{% endblock %}

{% block body %}

    <style>
        /* General Styles */
        .message-item:hover {
            background-color: #f1f1f1;
            cursor: pointer;
        }

        /* Chat Messages Container */
        .chat-messages {
            position: relative;
            display: flex;
            flex-direction: column;
            gap: 10px; /* Space between messages */
            padding: 10px;
            background-color: #f8f9fa;
            overflow-y: auto;
            max-height: 700px; /* Adjust based on design */
        }

        /* Base Styles for Messages */
        .chat-message {
            display: inline-block;
            max-width: 70%;
            padding: 10px;
            border-radius: 10px;
            font-size: 14px;
            line-height: 1.5;
            position: relative;
        }

        /* Received Messages (Left) */
        .chat-message.received {
            align-self: flex-start;
            background-color: #808b96 ;
            color: #000;
            border-top-left-radius: 0;
            border-bottom-left-radius: 15px;
            border-top-right-radius: 15px;
            text-align: left;
        }

        /* Sent Messages (Right) */
        .chat-message.sent {
            align-self: flex-end;
            background-color: #52be80 ;
            color: #000;
            border-top-right-radius: 0;
            border-bottom-right-radius: 15px;
            border-top-left-radius: 15px;
            text-align: right;
        }

        /* Message Content */
        .message-content {
            margin-bottom: 5px;
            word-wrap: break-word;
        }

        /* Timestamp for Messages */
        .message-time {
            font-size: 12px;
            color: #e5e8e8 !important;/*#6c757d;*/
            margin-top: 5px;
            margin-left: 5px;
            text-align: right; /* Align timestamp for sent messages */
        }
        .message-item img,.chat-header img,.chat-footer img{
            display: inline-flex;
            width: 40px;
            height: 40px;
            margin: 10px;
            align-items: center;
            justify-content: center;
            background: #eee;
            border-radius: 50%;
        }
        .chat-list-header {
            position: sticky;
            top: 0;
            background: white;
            z-index: 10;
            border-bottom: 1px solid #ccc;
        }

        .chat-header{
            border-bottom: 1px solid #ccc;
        }

        .chat-list-header h5 {
            margin: 0; /* Remove default margin */
            font-weight: bold; /* Bold title */
        }

        .chat-list-header .form-control {
            width: 300px; /* Set width for search input */
            height: 35px !important;
            margin-left: 10px; /* Space between title and input */
        }
        #chatMessages {
            background-image: url('{{asset('asset/img/background_chat.png')}}'); /* Replace with your image path */
            background-size: cover; /* Make the image cover the entire div */
            background-repeat: no-repeat; /* Prevent the image from repeating */
            background-position: center; /* Center the image */
            background-color: #f8f9fa; /* Fallback color */
        }

        #chatInputContainer .dropdown-toggle::after {
            content: none; /* This removes the arrow */
        }
        .attach-icon{
            width: 40px;
            height: 40px;
            display: flex;
            text-align: center;
            align-items: center;
            justify-content: center;
            color: white;
            cursor: pointer;
            border-radius: 50%;
        }
        .attach-icon.docum{
            background-color: #bb8fce ;
        }
        .attach-icon.pict{
            background-color: #c0392b ;
        }
        .attach-icon.vide{
            background-color: #483c98;
        }
        .attach-icon.aux{
            background-color: orange;
        }
        #chatInputContainer .dropdown ul li:hover{
            background-color: #f8f9fa;
        }
        #chatInputContainer .dropdown ul li:active{
            background-color:#0d6efd;
        }

        .header-search {
            position: relative;
            margin: 0;
            font-size: 0;
            line-height: 1;
            padding: 0;
            border: none;
        }
        .search-toggle {
            position: relative;
            display: block;
            font-size: 1.2rem;
            line-height: 1;
            min-width: 2.5rem;
            padding: .3rem .2rem;
            font-weight: 400;
            color: #b2babb;
            text-align: center;
            z-index: 11;
        }
        .header-search .header-search-wrapper {
            position: absolute;
            right: -1.4rem;
            top: 50%;
            margin-top: -20px;
            margin-right: 1.25rem;
            display: none;
            align-items: stretch;
            overflow: visible;
            border-radius: 20px;
            width: 100%;
            min-width: 270px;
            background-color: #fff;
            border: .1rem solid #ebebeb;
            border-radius: 20px;
            z-index: 10;
        }
        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }
        .header-search .form-control {
            flex: 1 1 auto;
            padding-right: 2.5rem;
            width: 100%;
            margin: 0;
            height: 38px;
            line-height: 20px;
            border: none;
            border-radius: 20px;
            box-shadow: none;
        }
        .search-toggle:hover, .search-toggle:focus, .search-toggle.active {
            color: #eea287;
        }
        .search-toggle:hover, .search-toggle:focus, .search-toggle.active {
            color: #c96;
            outline: none !important;
        }
        .header-search .header-search-wrapper.show {
            display: flex;
        }
        /* Highlight matching messages */
        .chat-message.highlight {
            background-color: #fff3cd; /* Light yellow highlight */
            border-left: 4px solid #ffc107; /* Yellow border for emphasis */
            padding-left: 8px; /* Adjust padding to match the border */
        }
        #button_send{
            display: none;
        }
        /* For screens smaller than 768px */
        @media (max-width: 1023px) {
            #button_send{
                display: block;
            }
        }


    </style>

