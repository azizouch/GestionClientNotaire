                                                        <label for="companyRC" class="form-label required">RC</label>
                                                        <input type="text" class="form-control" id="companyRC" required>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label for="companyVille" class="form-label required">Ville</label>
                                                        <input type="text" class="form-control" id="companyVille" required>
                                                    </div>
                                                </div>
                                                <div class="row mb-3">
                                                    <div class="col-md-12">
                                                        <label for="companyAddress" class="form-label required">Address</label>
                                                        <textarea class="form-control" id="companyAddress" rows="3" required></textarea>
                                                    </div>
                                                </div>
                                                <div class="row mb-3">
                                                    <div class="col-md-12">
                                                        <label for="companyDescription" class="form-label required">Description</label>
                                                        <textarea class="form-control" id="companyDescription" rows="5" required></textarea>
                                                    </div>
                                                </div>
                                                <!-- Additional fields for Personne Morale as needed -->
                                            </form>
                                        </div>

                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                                            <button type="button" class="btn btn-primary" id="saveNewClientButton">Enregistrer</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="{{ asset('asset/js/core/jquery-3.7.1.min.js') }}"></script>





