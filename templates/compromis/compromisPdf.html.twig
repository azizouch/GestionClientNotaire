                            <td style="height: 100px; border: 1px solid #000; padding: 8px; text-align: center; font-family: 'Times New Roman'"><strong style="font-size: 18px;">{% if person.genre == "Femelle" %}La bénéficiaire: {% else %} Le Bénéficier: {% endif %}{{ person.Civilite|upper }} {{ person.FirstName|upper }} {{ person.LastName|upper }}</strong></td>
