{% extends '_base.html.twig' %}

{% block title %}Liste desistements{% endblock %}

{% block body %}

    <link rel="stylesheet" href="{{ asset('asset/css/comunee.css') }}"/>

    <div class="container">
        <div class="page-inner pt-2">
            <div class="page-header m-0">
                <ul class="breadcrumbs mb-2">
                    <li class="nav-home">
                        <a href="{{ path('app_admin') }}">
                            <i class="icon-home"></i>
                        </a>
                    </li>
                    <li class="separator">
                        <i class="icon-arrow-right"></i>
                    </li>
                    <li class="nav-item">
                        <a href="#">Desistements</a>
                    </li>
                    <li class="separator">
                        <i class="icon-arrow-right"></i>
                    </li>
                    <li class="nav-item">
                        <a href="#">Liste desistements</a>
                    </li>
                </ul>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <div class="d-flex align-items-center">
                                <h4 class="card-title">Desistements <span class="badge bg-soft-dark text-dark ms-2">{{desistements|length}}</span></h4>
                                <button class="btn btn-primary btn-round ms-auto" data-bs-toggle="modal" data-bs-target="#addRowModal">
                                    <i class="fa fa-plus"></i>
                                    Nouveau
                                </button>
                            </div>
                        </div>
                        <div class="card-body">
                            <form method="GET" action="{{ path('app_desistements') }}">
                                <div class="row d-flex justify-content-between">

                                    <div class="col-4 col-md-2 mb-2 mb-md-3">
                                        <select name="itemsPerPage" id="itemsPerPage" class="form-control" onchange="this.form.submit()">
                                            <option value="10" {% if itemsPerPage == 10 %}selected{% endif %}>10</option>
                                            <option value="25" {% if itemsPerPage == 25 %}selected{% endif %}>25</option>
                                            <option value="50" {% if itemsPerPage == 50 %}selected{% endif %}>50</option>
                                            <option value="100" {% if itemsPerPage == 100 %}selected{% endif %}>100</option>
                                        </select>
                                    </div>

                                    <div class="col-8 col-md-4 mb-2">
                                        <select name="PmoraleName" id="PmoraleName" class="form-control" onchange="this.form.submit()">
                                            <option value="">Tous les entreprises</option>
                                            {% for pmorale in Pmorales %}
                                                <option value="{{ pmorale.name }}" {% if PmoraleName == '{{pmorale.name}}' %}selected{% endif %}>
                                                    {{ pmorale.name }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>

                                    <!-- Search Input -->
                                    <div class="col-12 col-md-6 mb-2">
                                        <input type="text" name="search" id="dossierSearch" class="form-control"
                                               placeholder="Rechercher une vente..." value="{{ searchQuery }}">
                                    </div>

                                    <!-- Hidden Submit Button (Not necessary but ensures form submission) -->
                                    <button type="submit" hidden></button>
                                </div>
                            </form>
                            <div class="table-responsive">
                                {% if pagination is not empty %}
                                <table id="multi-filter-select" class="display table table-striped table-hover">
                                    <thead>
                                    <tr>
                                        <th>Repertoire</th>
                                        <th>1ere partie(S)</th>
                                        <th>2eme partie(S)</th>
                                        <th>Statut</th>
                                        <th style="width: 10%">Action</th>
                                    </tr>
                                    </thead>
                                    <tbody>

                                    {% for desistement in pagination %}
                                        <tr>
                                            <td>{{ desistement.repertoir }}</td>
                                            <td>first part</td>
                                            <td>second part</td>
                                            <td>statue</td>
                                            <td>
                                                <div class="form-button-action">
                                                    <a class="btn-wt btn-white btn-wt-sm" href="#">
                                                        <i class="mdi mdi-eye "></i>  View
                                                    </a>
                                                    <a class="btn-wt btn-white btn-wt-sm mx-1" href="#">{#  {{path('app_update_product',{id: product.id})}} #}
                                                        <i class="mdi mdi-lead-pencil "></i>  Edit
                                                    </a>
                                                    <a class="btn-wt btn-white btn-wt-sm" href="#" onclick="">{# deleteItem('Product deleted successfuly','{{product.id}}') #}
                                                        <i class="mdi mdi-delete dropdown-item-icon"></i>  Delete
                                                    </a>
                                                    <form class="d-none" id="" action="" method="post"></form>{# {{product.id}}  {{path('app_delete_product',{id: product.id})}} #}
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                                {% else %}
                                    <div class="alert-search alert_warning text-center">Aucun résultat trouvé.</div>
                                {% endif %}
                            </div>
                            <div class="row navigation d-flex justify-content-center mt-3" >
                                {{ knp_pagination_render(pagination,'@KnpPaginator/Pagination/twitter_bootstrap_v4_pagination.html.twig') }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="{{ asset('asset/js/core/jquery-3.7.1.min.js') }}"></script>

{% endblock %}