                        <div class="card-body scrollbar scrollbar-inner" style="overflow: auto">
                            <div class="analytic-dash-activity " data-simplebar="init">
                                <div class="simplebar-content" style="padding: 0px;">
                                    <div class="activity">
                                        {% for log in logs %}
                                            <div class="activity-info">
                                                <div class="icon-info-activity">
                                                    <img src="{% if log.user.image %}{{ asset('uploads/' ~ log.user.image) }}{% else %}{{ asset('asset/img/avatar.png') }}{% endif %}" alt="" class="rounded-circle thumb-sm">
                                                </div>
                                                <div class="activity-info-text">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <p class="text-muted mb-0 font-13 w-75">
                                                            <span><strong>{{ log.user.username }}</strong></span><br>
                                                            <a href="#">{{ log.details }}</a>
                                                        </p>
                                                        <small class="text-muted">{{ log.timestamp|time_diff}}</small>
                                                        <small class="text-muted">{{ log.timestamp|date('d/m/Y H:i')}}</small>
                                                    </div>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div><!--end activity-->
                                </div>
                            </div><!--end analytics-dash-activity-->
                        </div>  <!--end card-body-->
                        <div class="card-footer">
                            <a class="see-all" href="{{ path('admin_audit_logs') }}">
                                Voir toutes les activités
                                <i class="fa fa-angle-right"></i>
                            </a>
                        </div>
                    </div><!--end card-->
                </div>
            </div>
        </div>
    </div>

    <script src="{{asset('asset/js/core/jquery-3.7.1.min.js')}}"></script>
    <script>
        var montantTotal = 0;

        $(document).ready(function () {

            var activites = $('.activites .scrollbar');
            if (activites.length > 0) {
                activites.scrollbar();
            }

            var recents = $('.recents .scrollbar');
            if (recents.length > 0) {
                recents.scrollbar();
            }

            // Initially hide the montant
            let montantHidden = false;

            $('#toggleMontant').click(function() {
                // Select the montant element
                const montantElement = $('#montantGlobal');

                if (montantHidden) {
                    // Show montant and change icon
                    montantElement.text(montantTotal + " Dh"); // Set the actual montant
                    $('#toggleMontant i').removeClass('fa-eye-slash').addClass('fa-eye');
                    $('#toggleMontant span').text('Masquer'); // Change text to "Masquer"
                } else {
                    // Hide montant and change icon
                    montantElement.text('********'); // Replace with asterisks
                    $('#toggleMontant i').removeClass('fa-eye').addClass('fa-eye-slash');
                    $('#toggleMontant span').text('Voir'); // Change text back to "Voir"
                }

                // Toggle the hidden state
                montantHidden = !montantHidden;
            });
        });

        function fetchStatistics() {

            $.ajax({
                url: '/api/statistics',
                type: 'GET',
                dataType: 'json',
                success: function (response) {
                    statisticsChart.data.datasets[0].data = response.desistements; // Update Desistements
                    statisticsChart.data.datasets[1].data = response.procurations; // Update Procurations
                    statisticsChart.data.datasets[2].data = response.compromis; // Update Compromis
                    statisticsChart.update(); // Update the chart
                },
                error: function (error) {
                    console.error('Error fetching statistics:', error);
                }
            });

            $.ajax({
                url: '/api/dashboard-data', // Unified API endpoint
                type: 'GET',
                dataType: 'json',
                success: function (response) {
                    // Update Daily Income Chart
                    dailyIncomeChart.data.labels = response.dailyIncome.map(item => item.day);
                    dailyIncomeChart.data.datasets[0].data = response.dailyIncome.map(item => parseFloat(item.total));
                    dailyIncomeChart.update(); // Refresh the chart

                    // Update Monthly Income Chart
                    let monthlyValues = Array(12).fill(0);
                    response.monthlyIncome.forEach(item => {
                        monthlyValues[item.month - 1] = parseFloat(item.total);
                    });
                    lineChart.data.datasets[0].data = monthlyValues;
                    lineChart.update(); // Refresh the chart

                    // Update Total Revenue Display
                    let totalRevenue = response.dailyIncome.reduce((sum, item) => sum + parseFloat(item.total), 0);
                    totalRevenue = totalRevenue.toLocaleString('fr-FR', {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
                    $('#totalRevenue').text(totalRevenue + ' Dh');

                    // Total income for the current year
                    let totalMonthlyIncome = response.monthlyIncome.reduce((sum, item) => sum + parseFloat(item.total), 0);
                    totalMonthlyIncome = totalMonthlyIncome.toLocaleString('fr-FR', {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
                    $('#totalIncomeDisplay').text(totalMonthlyIncome + ' Dh'); // Display in the card

                    // Update Total Montant Display
                    montantTotal = response.totalMontant;

                    // Update Date Range Display
                    let startDate = new Date(response.startDate).toLocaleDateString('fr-FR', {
                        month: 'long',
                        day: 'numeric'
                    });
                    let endDate = new Date(response.endDate).toLocaleDateString('fr-FR', {
                        month: 'long',
                        day: 'numeric'
                    });
                    $('#dateRange').text(`${startDate} - ${endDate}`);
                },
                error: function (error) {
                    console.error('Error fetching statistics:', error);
                }
            });
        }
        // Initial fetch
        fetchStatistics();

        // Auto-update every 30 seconds
        setInterval(fetchStatistics, 30000);

    </script>
{% endblock %}