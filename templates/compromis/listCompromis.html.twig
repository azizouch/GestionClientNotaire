{% extends '_base.html.twig' %}

{% block title %}Liste compromis{% endblock %}

{% block body %}
    <link rel="stylesheet" href="{{ asset('asset/css/comune.css') }}"/>

    <div class="container">
        <div class="page-inner pt-3">
            <div class="page-header m-0">
                <h3 class="fw-bold mb-3">Liste compromis</h3>
                <ul class="breadcrumbs mb-3">
                    <li class="nav-home">
                        <a href="{{ path('app_admin') }}">
                            <i class="icon-home"></i>
                        </a>
                    </li>
                    <li class="separator">
                        <i class="icon-arrow-right"></i>
                    </li>
                    <li class="nav-item">
                        <a href="#">Tables</a>
                    </li>
                    <li class="separator">
                        <i class="icon-arrow-right"></i>
                    </li>
                    <li class="nav-item">
                        <a href="#">Datatables</a>
                    </li>
                </ul>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <div class="d-flex align-items-center">
                                <h4 class="card-title">Compromis <span class="badge bg-soft-dark text-dark ms-2">{{compromis|length}}</span></h4>
                                <button class="btn btn-primary btn-round ms-auto" onclick="window.location.href='{{ path('app_add_new_compromis') }}'" data-bs-toggle="modal" data-bs-target="#addRowModal">
                                    <i class="fa fa-plus"></i>
                                    Nouveau compromis
                                </button>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table id="multi-filter-select" class="display table table-hover">
                                    <thead>
                                        <tr style="background-color: #d0ece7 ">
                                            <th>Repertoire</th>
                                            <th>Montant de l'affaire</th>
                                            <th>1ere partie(S)</th>
                                            <th>2eme partie(S)</th>
                                            <th>Statut</th>
                                            <th style="width: 10%">Action</th>
                                        </tr>
                                    </thead>
                                    <tfoot>
                                        <tr>
                                            <th>Repertoire</th>
                                            <th>Montant de l'affaire</th>
                                            <th>1ere partie(S)</th>
                                            <th>2eme partie(S)</th>
                                            <th>Statut</th>
                                            <th style="width: 10%">Action</th>
                                        </tr>
                                    </tfoot>
                                    <tbody>
                                    <tr>
                                        <th>534/2024</th>
                                        <th>299729,34</th>
                                        <th><span class="badge bg-soft-dark text-dark ms-1 fw-bold text-uppercase" style="font-size: 12px">immolog</span></th>
                                        <th><span class="badge bg-soft-dark text-dark ms-1 fw-bold text-uppercase " style="font-size: 12px">mahjouba lafissi</span></th>
                                        <th><span class="badge bg-soft-success text-success border-0" style="font-size: 11px">Statut</span></th>
                                        <th style="width: 10%">Action</th>
                                    </tr>
                                    {% for comp in compromis %}
                                        <tr>
                                            <td>{{ comp.id }}</td>
                                            <td>{{ comp.designation.montant_TTC }}</td>
                                            <td><span class="badge bg-soft-dark text-dark ms-1 fw-bold text-uppercase" style="font-size: 12px">
                                                {# Display the name of the person with the role 'Promettant' #}
                                                {% for person in comp.getPphysique() %}
                                                    {% if 'Promettant' in person.getRoles() %}
                                                        {{ person.name }}
                                                    {% endif %}
                                                {% endfor %}
                                                {% for person in comp.getPmoral() %}
                                                    {% if 'Promettant' in person.getRoles() %}
                                                        {{ person.name }}
                                                    {% endif %}
                                                {% endfor %}
                                                </span>
                                            </td>
                                            <td><span class="badge bg-soft-dark text-dark ms-1 fw-bold text-uppercase" style="font-size: 12px">
                                                {# Display the name of the person with the role 'Bénéficiaire' #}
                                                {% for person in comp.getPphysique() %}
                                                    {% if 'Bénéficiaire' in person.getRoles() %}
                                                        {{ person.name }}
                                                    {% endif %}
                                                {% endfor %}
                                                {% for person in comp.getPmoral() %}
                                                    {% if 'Bénéficiaire' in person.getRoles() %}
                                                        {{ person.name }}
                                                    {% endif %}
                                                {% endfor %}
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge bg-soft-success text-success border-0" style="font-size: 11px">active</span>
                                            </td>
                                            <td>
                                                <div class="dropdown">
                                                    <button class="btn btn-label-info btn-round btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                        <small class="btn-label"><i class="fa fa-print"></i></small>Print
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-end">
                                                        <li><a class="dropdown-item" href="{{ path('app_compromis_pdf', { id: procuration.id }) }}" target="_blank"><i class="fa fa-file-pdf"></i> Pdf</a></li>
                                                        <li><a class="dropdown-item" href="{{ path('app_compromis_pdf_eng', { id: procuration.id }) }}" target="_blank"><i class="fa fa-file-pdf"></i> Pdf Eng</a></li>
                                                        <li><a class="dropdown-item" href="#" target="_blank"><i class="fa fa-file-word"></i> Word</a></li>
                                                        {#                                                        <li><a class="dropdown-item" href="{{ path('app_procuration_word_eng', { id: procuration.id }) }}" target="_blank"><i class="fa fa-file-word"></i> Word Eng</a></li>#}
                                                    </ul>
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="{{ asset('asset/js/core/jquery-3.7.1.min.js') }}"></script>
    <script src="{{ asset('asset/js/plugin/datatables/datatables.min.js') }}"></script>
    <script>
        $(document).ready(function () {
            $("#basic-datatables").DataTable({});

            $("#multi-filter-select").DataTable({
                pageLength: 5,
                initComplete: function () {
                    this.api()
                        .columns()
                        .every(function () {
                            var column = this;
                            var select = $(
                                '<select class="form-select"><option value=""></option></select>'
                            )
                                .appendTo($(column.footer()).empty())
                                .on("change", function () {
                                    var val = $.fn.dataTable.util.escapeRegex($(this).val());

                                    column
                                        .search(val ? "^" + val + "$" : "", true, false)
                                        .draw();
                                });

                            column
                                .data()
                                .unique()
                                .sort()
                                .each(function (d, j) {
                                    select.append(
                                        '<option value="' + d + '">' + d + "</option>"
                                    );
                                });
                        });
                },
            });

            // Add Row
            $("#add-row").DataTable({
                pageLength: 5,
            });

            var action =
                '<td> <div class="form-button-action"> <button type="button" data-bs-toggle="tooltip" title="" class="btn btn-link btn-primary btn-lg" data-original-title="Edit Task"> <i class="fa fa-edit"></i> </button> <button type="button" data-bs-toggle="tooltip" title="" class="btn btn-link btn-danger" data-original-title="Remove"> <i class="fa fa-times"></i> </button> </div> </td>';

            $("#addRowButton").click(function () {
                $("#add-row")
                    .dataTable()
                    .fnAddData([
                        $("#addName").val(),
                        $("#addPosition").val(),
                        $("#addOffice").val(),
                        action,
                    ]);
                $("#addRowModal").modal("hide");
            });
        });
    </script>

{% endblock %}