        // Function to keep only the first partner field
        function keepOnlyFirstPartner() {
            const partnerFields = partnerContainer.querySelectorAll("[id^='partnerFields_']");
            if (partnerFields.length > 1) {
                // Remove all partner fields except the first one
                for (let i = 1; i < partnerFields.length; i++) {
                    partnerFields[i].remove();
                }
                partnerIndex = 1; // Reset the counter
            }
        }

        // Function to remove the person from selectedPersons
        function removeFromSelectedPersons(identifier) {
            console.log("Identifier to remove:", identifier);
            console.log("Before removal:", selectedPersons);

            selectedPersons = selectedPersons.filter(function(person) {
                return String(person.companyRC) !== String(identifier) && String(person.identifiant) !== String(identifier);
            });

            console.log("After removal:", selectedPersons);

            // Update the hidden input with the updated selectedPersons array
            $('#contrat_selectedPersons').val(JSON.stringify(selectedPersons));
        }

        // Function to update inner fieldset indices
        function updateInnerFieldsetIndices(outerFieldset, outerIndex) {
            const rolesContainer = outerFieldset.querySelector('[id$="_roles"]');
            const partnersContainer = outerFieldset.querySelector('[id$="_partenaire"]');

            // Update roles fieldsets
            if (rolesContainer) {
                const rolesPrototype = rolesContainer.getAttribute('data-prototype');
                const rolesIndex = rolesContainer.children.length; // Count current roles
                const uniqueRolesPrototype = rolesPrototype.replace(/__name__/g, rolesIndex);
                const rolesTemplate = document.createElement('template');
                rolesTemplate.innerHTML = uniqueRolesPrototype.trim();
                rolesContainer.appendChild(rolesTemplate.content.firstElementChild);
            }

            // Update partners fieldsets
            if (partnersContainer) {
                const partnersPrototype = partnersContainer.getAttribute('data-prototype');
                const partnersIndex = partnersContainer.children.length; // Count current partners
                const uniquePartnersPrototype = partnersPrototype.replace(/__name__/g, partnersIndex);
                const partnersTemplate = document.createElement('template');
                partnersTemplate.innerHTML = uniquePartnersPrototype.trim();
                partnersContainer.appendChild(partnersTemplate.content.firstElementChild);
            }
        }

        function addToFieldsetPersonPhysique(personData) {

            const container = document.getElementById('contrat_pphysique');
            const prototype = container.getAttribute('data-prototype');

            // Get the current number of fields and replace placeholders in the prototype
            const outerIndex  = container.children.length;
            const uniquePrototype = prototype.replace(/__name__/g, outerIndex );
            // Convert the uniquePrototype string into an actual DOM element
            const template = document.createElement('template');
            template.innerHTML = uniquePrototype.trim(); // Trim to avoid unwanted spaces

            // Get the fieldset element from the template
            const newOuterFieldset  = template.content.firstElementChild;

            newOuterFieldset .setAttribute('data-cin', personData.cin);
            // Now handle the inner fieldsets (roles and partners)
            updateInnerFieldsetIndices(newOuterFieldset, outerIndex);

            const newPersonFieldset = newOuterFieldset.querySelector(`#contrat_pphysique_${outerIndex}`);

            if (newPersonFieldset) {
                newPersonFieldset.querySelector('[name$="[civilite]"]').value = personData.civilite;
                newPersonFieldset.querySelector('[name$="[first_name]"]').value = personData.firstName;
                newPersonFieldset.querySelector('[name$="[last_name]"]').value = personData.lastName;
                newPersonFieldset.querySelector('[name$="[prenom_pere]"]').value = personData.firstNameFather;
                newPersonFieldset.querySelector('[name$="[prenom_mere]"]').value = personData.firstNameMother;
                newPersonFieldset.querySelector('[name$="[cin]"]').value = personData.cin;
                newPersonFieldset.querySelector('[name$="[telephone]"]').value = personData.phone;
                newPersonFieldset.querySelector('[name$="[situation]"]').value = personData.situation;
                newPersonFieldset.querySelector('[name$="[genre]"]').value = personData.genre;
                newPersonFieldset.querySelector('[name$="[email]"]').value = personData.email;
                newPersonFieldset.querySelector('[name$="[city]"]').value = personData.ville;
                newPersonFieldset.querySelector('[name$="[address]"]').value = personData.address;
                newPersonFieldset.querySelector('[name$="[birth_date]"]').value = personData.dateNaissance;
                newPersonFieldset.querySelector('[name$="[expiration_cin]"]').value = personData.dateExpiration;
                newPersonFieldset.querySelector('[name$="[birth_place]"]').value = personData.birth_place;
                newPersonFieldset.querySelector('[name$="[nationality]"]').value = personData.nationality;

                // Add the selected role to the roles fieldset
                const rolesContainer = newPersonFieldset.querySelector(`#contrat_pphysique_${outerIndex}_roles`);
                if (rolesContainer && selectedRole) {
                    const rolePrototype = rolesContainer.getAttribute('data-prototype');
                    const roleIndex = rolesContainer.children.length;

                    // Replace placeholders in the roles prototype
                    const newRole = rolePrototype
                        .replace(/__name__/g, roleIndex)
                        .replace(/__name__label__/g, `Role ${roleIndex + 1}`);

                    // Create a new div for the role and append it
                    const roleDiv = document.createElement('div');
                    roleDiv.innerHTML = newRole;

                    // Set the role name field value to the selected role
                    roleDiv.querySelector(`[name$="[name]"]`).value = selectedRole;

                    // Append the new role to the roles fieldset
                    rolesContainer.appendChild(roleDiv);
                }
                // Add partner data if it exists
                // Assuming 'index' is defined correctly based on your context
                if (personData.partnerData && Array.isArray(personData.partnerData)) {
                    const partnerContainer = newPersonFieldset.querySelector(`#contrat_pphysique_${outerIndex}_partenaire`);
                    const partnerPrototype = partnerContainer.getAttribute('data-prototype');

                    personData.partnerData.forEach((partner, idx) => {
                        // Get the current count of partners
                        const partnerIndex = partnerContainer.children.length;

                        // Replace the placeholder in the prototype with the current count
                        const uniquePartnerPrototype = partnerPrototype.replace(/__name__/g, partnerIndex);

                        // Create a new div for the partner fieldset
                        const newPartnerFieldset = document.createElement('div');
                        newPartnerFieldset.innerHTML = uniquePartnerPrototype;

                        // Update the ID of the new partner fieldset
                        const partnerFieldsetDiv = newPartnerFieldset.querySelector(`[id^="contrat_pphysique_${outerIndex}_partenaire_"]`);
                        if (partnerFieldsetDiv) {
                            partnerFieldsetDiv.id = `contrat_pphysique_${index}_partenaire_${partnerIndex}`; // Set unique ID
                        }

                        // Populate partner data fields if available
                        newPartnerFieldset.querySelector('[name$="[first_name]"]').value = partner.partnerFirstName || '';
                        newPartnerFieldset.querySelector('[name$="[last_name]"]').value = partner.partnerLastName || '';
                        newPartnerFieldset.querySelector('[name$="[mariage_year]"]').value = partner.mariageDate || '';
                        newPartnerFieldset.querySelector('[name$="[mariage_place]"]').value = partner.mariagePlace || '';

                        // Append the new partner fieldset to the partner container
                        partnerContainer.appendChild(newPartnerFieldset);
                    });
                } else {
                    console.error('No partner data available to process.');
                }
            }

            // Append the new fieldset to the container
            container.appendChild(newOuterFieldset);

            // Optionally, you can reset the form or handle any other UI logic after adding the new fieldset
            document.getElementById('personnePhysiqueForm').reset();

            // Reset other related fields if needed
            document.getElementById('partnerContainer').style.display = 'none';
            document.getElementById('partenaire').style.display = 'none';

            // Initial setup to ensure only the first partner is displayed
            keepOnlyFirstPartner();

            const newPersonData = {
                type: personData.type,
                name: personData.firstName + " " + personData.lastName,
                identifiant:personData.cin,
                ville: personData.ville,
                telephone: personData.phone,
                email: personData.email,
                cin: personData.cin,
            }

            // Optionally, display the person data in a table or any other structure
            if (selectedRole === "Promettant") {
                displayPersonInTable(newPersonData, 'PromettantTable');
            } else if (selectedRole === "Bénéficiaire") {
                displayPersonInTable(newPersonData, 'BeneficiaireTable');
            }

            // Hide the modal after adding the person
            const modalElement = document.getElementById('newClientModal2');
            const modal = bootstrap.Modal.getInstance(modalElement);
            modal.hide();
        }

        function addToFieldsetPersonMorale(personData){
            const container = document.getElementById('contrat_pmorale');
            const prototype = container.getAttribute('data-prototype');  // Get the prototype
            const newFieldset = document.createElement('div');  // Create a new div for the fieldset

            // Get the current number of fields and replace placeholders in the prototype
            const index = container.children.length;
            const uniquePrototype = prototype.replace(/__name__/g, index);  // Replace placeholders with index

            // Add the fieldset's data-cin attribute to link the fieldset with the person
            newFieldset.setAttribute('data-if', personData.companyIF);

            // Set the new fieldset's content
            newFieldset.innerHTML = uniquePrototype;

            // Append the new fieldset to the container
            container.appendChild(newFieldset);

            // Select the newly created fieldset using the correct id
            const newPersonFieldset = newFieldset.querySelector(`#contrat_pmorale_${index}`);

            // Populate the new fieldset with the client data
            newPersonFieldset.querySelector('[name$="[name]"]').value = personData.companyName;
            newPersonFieldset.querySelector('[name$="[RC]"]').value = personData.companyRC;
            newPersonFieldset.querySelector('[name$="[identifiant_fiscal]"]').value = personData.companyIF;
            newPersonFieldset.querySelector('[name$="[iCE]"]').value = personData.companyICE;
            newPersonFieldset.querySelector('[name$="[ville]"]').value = personData.companyVille;
            newPersonFieldset.querySelector('[name$="[adresse]"]').value = personData.companyAddress;
            newPersonFieldset.querySelector('[name$="[description]"]').value = personData.companyDescription;

            // Add the selected role to the roles fieldset
            const rolesContainer = newPersonFieldset.querySelector(`#contrat_pmorale_${index}_roles`);
            if (rolesContainer && selectedRole) {
                const rolePrototype = rolesContainer.getAttribute('data-prototype');
                const roleIndex = rolesContainer.children.length;

                // Replace placeholders in the roles prototype
                const newRole = rolePrototype
                    .replace(/__name__/g, roleIndex)
                    .replace(/__name__label__/g, `Role ${roleIndex + 1}`);

                // Create a new div for the role and append it
                const roleDiv = document.createElement('div');
                roleDiv.innerHTML = newRole;

                // Set the role name field value to the selected role
                roleDiv.querySelector(`[name$="[name]"]`).value = selectedRole;

                // Append the new role to the roles fieldset
                rolesContainer.appendChild(roleDiv);
            }

            // Append the new fieldset to the container
            container.appendChild(newFieldset);

            // Optionally, you can reset the form or handle any other UI logic after adding the new fieldset
            document.getElementById('personneMoraleForm').reset();

            // Optionally, display the person data in a table or any other structure
            if(selectedRole === "Promettant"){
                displayPersonInTable(personData,'PromettantTable');
            }else if(selectedRole === "Bénéficiaire"){
                displayPersonInTable(personData,'BeneficiaireTable');
            }

            // Hide the modal after adding the person
            const modalElement = document.getElementById('newClientModal2');
            const modal = bootstrap.Modal.getInstance(modalElement);
            modal.hide();
        }

        function displayPersonInTable(person, targetTable) {
            let newRow;
            // Check if it's a personPhysique or personMorale
            if (person.type === 'personPhysique') {
                newRow = $(`
                <tr data-cin="${person.identifiant}">
                    <td>${person.name}</td>
                    <td>CIN: ${person.identifiant}</td>
                    <td>${person.ville}</td>
                    <td>${person.telephone}</td>
                    <td>${person.email}</td>
                    <td class="text-center"><button type="button" class="btn btn-danger btn-sm delete-client"><i class="fas fa-trash-alt"></i></button></td>
                </tr>
            `);
            } else if (person.type === 'personMorale') {
                newRow = $(`
                <tr data-if="${person.companyRC}">
                    <td>${person.name}</td>
                    <td>RC: ${person.companyRC}</td>
                    <td>${person.ville}</td>
                    <td>${person.telephone}</td>
                    <td>${person.email}</td>
                    <td class="text-center"><button type="button" class="btn btn-danger btn-sm delete-client"><i class="fas fa-trash-alt"></i></button></td>
                </tr>
            `);
            } else {
                console.error(`Unknown person type: ${person.type}`);
                return; // Exit the function if the person type is unknown
            }

            // Append the row to the specified table
            $(`#${targetTable} tbody`).append(newRow);
        }

        function deletePersonFromFieldset(identifier) {
            // Try to find the fieldset using the data-cin attribute
            let fieldsetToDelete = document.querySelector(`[data-cin="${identifier}"]`);

            // If not found, try finding it using the data-if attribute (for personMorale)
            if (!fieldsetToDelete) {
                fieldsetToDelete = document.querySelector(`[data-if="${identifier}"]`);
            }

            if (fieldsetToDelete) {
                fieldsetToDelete.remove(); // Remove the fieldset from the DOM
            }
        }

        function checkPersonExists(cin) {
            const existsInPromettant = $(`#PromettantTable tbody tr[data-cin="${cin}"]`).length > 0;
            const existsInBeneficiaire = $(`#BeneficiaireTable tbody tr[data-cin="${cin}"]`).length > 0;

            return existsInPromettant || existsInBeneficiaire;
        }

        function showAlert(message) {
            swal("Warning!", message, {
                icon: "warning",
                buttons: {
                    confirm: {
                        text: "Okay",
                        className: "btn btn-warning",
                    },
                },
            });
        }

    </script>

