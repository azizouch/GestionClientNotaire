                                            </div>
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col-md-12">
                                                {{ form_label(form.designation.adresse) }}
                                                {{ form_widget(form.designation.adresse, { 'attr': { 'class': 'form-control shadow-sm' } }) }}
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    {{ form_row(form.date_premiere_part, { 'attr': { 'class': 'form-control shadow-sm' } }) }}
