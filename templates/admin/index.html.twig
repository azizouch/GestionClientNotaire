    <script>

        document.addEventListener("DOMContentLoaded", function () {
            let tooltip = document.createElement("div");
            tooltip.id = "regionTooltip";
            tooltip.className = "custom-tooltip";
            document.body.appendChild(tooltip);

            document.querySelectorAll(".mapsvg-region").forEach(region => {
                region.addEventListener("mouseenter", function (event) {
                    tooltip.innerText = this.getAttribute("title"); // Get region name
                    tooltip.style.display = "block";
                });

                region.addEventListener("mousemove", function (event) {
                    let offsetX = 15; // Distance from cursor (X)
                    let offsetY = 15; // Distance from cursor (Y)
                    tooltip.style.left = event.pageX + offsetX + "px";
                    tooltip.style.top = event.pageY + offsetY + "px";
                });

                region.addEventListener("mouseleave", function () {
                    tooltip.style.display = "none";
                });
            });

            const zoomInBtn = document.querySelector(".mapsvg-in");
            const zoomOutBtn = document.querySelector(".mapsvg-out");
            const svg = document.querySelector(".map-container svg");

            let scale = 1;
            const zoomFactor = 0.5; // Adjust for smoother zooming
            let isDragging = false;
            let startX, startY;
            let translateX = 0, translateY = 0;

            // Set smooth transition for zooming
            svg.style.transition = "transform 0.3s ease-in-out";

            // 🔍 Zoom In Function
            zoomInBtn.addEventListener("click", zoomIn);

            // Zoom Out Function
            zoomOutBtn.addEventListener("click", zoomOut);
            // Mouse Scroll Zooming
            svg.addEventListener("wheel", function (event) {
                event.preventDefault(); // Prevent default scrolling behavior
                if (event.deltaY < 0) {
                    zoomIn(); // Zoom in on scroll up
                } else {
                    zoomOut(); // Zoom out on scroll down
                }
            });

            // Drag Start
            svg.addEventListener("mousedown", function (event) {
                isDragging = true;
                startX = event.clientX - translateX;
                startY = event.clientY - translateY;
                svg.style.cursor = "grabbing"; // Show grabbing cursor
            });

            // ️ Drag Move
            document.addEventListener("mousemove", function (event) {
                if (isDragging) {
                    translateX = event.clientX - startX;
                    translateY = event.clientY - startY;
                    updateTransform();
                }
            });

            // Drag End
            document.addEventListener("mouseup", function () {
                isDragging = false;
                svg.style.cursor = "grab"; // Reset cursor
            });

            // Zoom In Function
            function zoomIn() {
                scale = Math.min(scale + zoomFactor, 3); // Limit max zoom level
                updateTransform();
            }

            // Zoom Out Function
            function zoomOut() {
                if (scale > 1.1) {
                    scale -= zoomFactor;
                } else {
                    scale = 0.565287; // Reset zoom to default
                    translateX = 0;
                    translateY = 0;
                }
                updateTransform();
            }

            // Update Transform (Zoom & Pan)
            function updateTransform() {
                svg.style.transform = `translate(${translateX}px, ${translateY}px) scale(${scale})`;
            }
        });

        $(document).ready(function () {

            var activites = $('.activites .scrollbar');

            if (activites.length > 0) {
                activites.scrollbar();
            }

            var recents = $('.recents .scrollbar');

            if (recents.length > 0) {
                recents.scrollbar();
            }
        });

        $.ajax({
            url: '/api/statistics', // Correct URL
            type: 'GET', // Use 'GET' method to fetch data
            dataType: 'json', // Expect JSON response
            success: function(response) {
                console.log(response); // Log response for debugging
                statisticsChart.data.datasets[0].data = response.desistements; // Update Desistements
                statisticsChart.data.datasets[1].data = response.procurations; // Update Procurations
                statisticsChart.data.datasets[2].data = response.compromis; // Update Compromis
                statisticsChart.update(); // Update the chart
            },
            error: function(error) {
                console.error('Error fetching statistics:', error);
            }
        });

    </script>
