{% extends '_base.html.twig' %}

{% block title %}Kaiadmin | Dashboard{% endblock %}

{% block body %}

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('asset/css/chats.css') }}">
    <div class="container">
        <div class="page-inner pb-0">
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-body pb-0">
                            <div class="d-flex listmessage pb-3">
                                <!-- Messages List (Left) -->
                                <div class="messages-list scrollbar scrollbar-inner"  style="position: relative; width: 30%; border-right: 1px solid #ccc; overflow: auto;padding-right: 21px">
                                    <!-- Chat List Header -->
                                    <div class="chat-list-header d-flex align-items-center p-3">
                                        <button class="btn p-2 border-0 d-none" type="button" style="border-radius: 15px;" id="buttonBackTochat">
                                            <i class="fa fa-arrow-left fa-fw fa-lg text-muted"></i>
                                        </button>
                                        <h5 class="mb-0 me-3">Chats</h5>
                                        <input type="text" class="form-control" placeholder="Search..." id="Inputsearch">
                                        <button class="btn p-2 bg-success" type="button" style="border-radius: 15px;margin-left: 10px" id="buttonAddChat">
                                            <i class="fa fa-comment-medical fa-fw fa-lg text-muted"></i>
                                        </button>
                                    </div>

                                    <div class="users-active-container" id="usersActiveContainer">
                                        {% for user in usersWithMessages %}
                                            <div class="message-item-exist shadow-sm d-flex align-items-center p-2 border-bottom"
                                                 data-id="{{ user.id }}"
                                                 data-name="{{ user.username }}"
                                                 data-img="{{ asset(user.image ?: 'asset/img/avatar.png') }}">
                                                <img src="{{ asset(user.image ?: 'asset/img/avatar.png') }}" class="rounded-circle me-3" alt="User">
                                                <div class="message-info">
                                                    <h6 class="mb-0">{{ user.username }}</h6>
                                                    <small class="text-muted">{{ user.lastMessage }}</small>
                                                </div>
                                                {% if user.lastMessageTime is defined %}
                                                    <span class="text-muted ms-auto" style="font-size: 12px;">{{ user.lastMessageTime|date('h:i A') }}</span>
                                                {% endif %}
                                            </div>
                                        {% else %}
                                            <p class="text-muted text-center">No messages yet.</p>
                                        {% endfor %}
                                    </div>

                                    <div class="users-exist-container d-none" id="usersExistContainer">
                                        {% for user in users %}
                                            {% if user.id != currentUser.id %}
                                                <div class="message-item shadow-sm d-flex align-items-center p-2 border-bottom"
                                                     data-id="{{ user.id }}"
                                                     data-name="{{ user.username }}"
                                                     data-img="{% if user.image %}{{ asset(user.image) }}{% else %}{{ asset('asset/img/avatar.png') }}{% endif %}">
                                                    {% if user.image %}
                                                        <img src="{{ asset(user.image) }}" class="rounded-circle me-3" alt="{{ user.username }}">
                                                    {% else %}
                                                        <img src="{{ asset('asset/img/avatar.png') }}" class="rounded-circle me-3" alt="{{ user.username }}">
                                                    {% endif %}
                                                    <div class="message-info">
                                                        <h6 class="mb-0">{{ user.username }}</h6>
                                                        <small class="text-muted">Click to start chat</small>
                                                    </div>
                                                </div>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                </div>
                                <!-- Chat Area (Right) -->
                                <div class="chat-area flex-grow-1 d-flex flex-column" style="padding-left: 1.5rem !important;padding-bottom: 1.5rem !important;min-height: 100%;">
                                    <!-- Chat Header -->
                                    <div id="chatHeader" class="chat-header d-flex align-items-center pt-0 pb-1">
                                        <input type="hidden" id="currentUserId" value="{{ currentUser.id }}">
                                        <img src="{{ asset('asset/img/user.png') }}" class="rounded-circle me-3" alt="User">
                                        <h6 class="mb-0" id="chatName">Select a Chat</h6>
                                        <div class="header-search ms-auto">
                                            <a href="#" class="search-toggle" role="button"><i class="fas fa-search"></i></a>
                                            <div class="header-search-wrapper">
                                                <label for="chatSearch" class="sr-only">Search</label>
                                                <input type="search" class="form-control" name="chatSearch" id="chatSearch" placeholder="Search in..." required="">
                                            </div><!-- End .header-search-wrapper -->
                                        </div>
                                    </div>

                                    <!-- Chat Messages -->
                                    <div id="chatMessages" class="chat-messages flex-grow-1 p-3 overflow-auto scrollbar scrollbar-inner" style="background-color: #f8f9fa;">
                                    </div>

                                    <!-- Chat Input -->
                                    <div id="chatInputContainer" class="chat-input align-items-center border-top" style="display: none">
                                        <span id="selectedUserId" class="d-none" ></span>
                                        <div class="chat-footer">
                                            <img src="{{ asset('asset/img/profile.jpg') }}" class="rounded-circle" alt="User">
                                        </div>
                                        <input type="text" id="messageInput" class="form-control border-0" placeholder="Type your message...">
                                        <!-- Attach Button with Dropdown -->
                                        <div class="dropdown me-2">
                                            <button class="btn p-2 dropdown-toggle bg-warning" type="button" style="border-radius: 15px" id="attachDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="fa fa-paperclip fa-fw fa-lg text-muted"></i>
                                            </button>
                                            <ul class="dropdown-menu" aria-labelledby="attachDropdown">
                                                <li class="d-flex align-items-center justify-content-center" onclick="selectFile('image')">
                                                    <div class="attach-icon pict">
                                                        <i class="fa fa-image"></i>
                                                    </div>
                                                    <a class="dropdown-item w-50" href="#" >Image</a>
                                                </li>
                                                <li class="d-flex align-items-center justify-content-center my-2" onclick="selectFile('video')">
                                                    <div class="attach-icon vide">
                                                        <i class="fa fa-video"></i>
                                                    </div>
                                                    <a class="dropdown-item w-50" href="#" >Video</a>
                                                </li>
                                                <li class="d-flex align-items-center justify-content-center my-2" onclick="selectFile('audio')">
                                                    <div class="attach-icon aux">
                                                        <i class="fa fa-headphones"></i>
                                                    </div>
                                                    <a class="dropdown-item w-50" href="#">Audio</a>
                                                </li>
                                                <li class="d-flex align-items-center justify-content-center" onclick="selectFile('file')">
                                                    <div class="attach-icon docum">
                                                        <i class="fa fa-file"></i>
                                                    </div>
                                                    <a class="dropdown-item w-50" href="#" >File</a>
                                                </li>
                                            </ul>
                                        </div>
                                        <button class="btn p-2 bg-success" type="button" style="border-radius: 15px;" id="button_send" onclick="sendMessage()">
                                            <i class="fa fa-paper-plane fa-fw fa-lg text-muted"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="{{asset('asset/js/core/jquery-3.7.1.min.js')}}"></script>

    <script>
        const $buttonAddChat = $('#buttonAddChat');
        const $buttonBackToChat = $('#buttonBackTochat');
        const $usersActiveContainer = $('#usersActiveContainer');
        const $usersExistContainer = $('#usersExistContainer');
        const currentUserId = parseInt(document.getElementById('currentUserId').value, 10);
        let selectedUserId = null;

        $(document).ready(function () {

            // Show the `users-exist-container` and hide the `users-active-container`
            $buttonAddChat.on('click', function () {
                $usersActiveContainer.addClass('d-none');
                $usersExistContainer.removeClass('d-none');
                $buttonBackToChat.removeClass('d-none');
                $buttonAddChat.addClass('d-none');

                // Populate the `users-exist-container` only if it is empty
                if ($usersExistContainer.html().trim() === '') {
                    $usersExistContainer.find('.message-item').each(function () {
                        const $item = $(this);
                        const userName = $item.data('name');
                        const userImg = $item.data('img');
                        const userId = $item.data('id');

                        const userItem = `
                            <div class="message-item shadow-sm d-flex align-items-center p-2 border-bottom" onclick="selectUser('${userName}', '${userImg}', '${userId}')">
                                <img src="${userImg}" class="rounded-circle me-3" alt="User">
                                <div class="message-info">
                                    <h6 class="mb-0">${userName}</h6>
                                    <small class="text-muted">Click to start chat</small>
                                </div>
                            </div>
                        `;
                        $usersExistContainer.append(userItem);
                    });
                }
            });

            // Event listener for the back button
            $buttonBackToChat.on('click', function () {
                $usersExistContainer.addClass('d-none');
                $usersActiveContainer.removeClass('d-none');
                $buttonBackToChat.addClass('d-none');
                $buttonAddChat.removeClass('d-none');
            });

            $(document).on('click', '.message-item', function () {
                const $item = $(this);
                const userName = $item.data('name');
                const userImg = $item.data('img');
                const selecteduserId = $item.data('id');

                // Call the selectUser function
                selectUser(userName, userImg, selecteduserId);
            });

            $(document).on('click', '.message-item-exist', function () {
                const $item = $(this);
                const userName = $item.data('name');
                const userImg = $item.data('img');
                const selecteduserId = $item.data('id');

                // Call the openChat function
                openChat(userName, userImg, selecteduserId);
            });
        });

        // Function to select a user and switch to chat
        function selectUser(userName, imageUrl, selecteduserId) {
            const existingUser = $usersActiveContainer.children().filter(function () {
                const $nameElement = $(this).find('.message-info h6');
                return $nameElement.text().trim() === userName;
            });

            if (existingUser.length) {
                toggleChatContainers(true);
                openChat(userName, imageUrl, selecteduserId);
                return;
            }

            const userItem = `
                    <div class="message-item shadow-sm d-flex align-items-center p-2 border-bottom">
                        <img src="${imageUrl}" class="rounded-circle me-3" alt="User">
                        <div class="message-info">
                            <h6 class="mb-0">${userName}</h6>
                            <small class="text-muted">Last message...</small>
                        </div>
                        <span class="text-muted ms-auto" style="font-size: 12px;">10:45 AM</span>
                    </div>
                `;
            $usersActiveContainer.append(userItem);

            toggleChatContainers(true);

            openChat(userName, imageUrl, selecteduserId);
        }

        // Utility function to toggle visibility
        function toggleChatContainers(showActiveContainer = true) {
            if (showActiveContainer) {
                $usersExistContainer.addClass('d-none');
                $usersActiveContainer.removeClass('d-none');
            } else {
                $usersExistContainer.removeClass('d-none');
                $usersActiveContainer.addClass('d-none');
            }
            $buttonBackToChat.addClass('d-none');
            $buttonAddChat.removeClass('d-none');
        }

        const fetchAndDisplayMessages = async (currentUserId, otherUserId) => {
            const messageContainer = document.getElementById('chatMessages');

            try {
                const response = await fetch(`/messages/${currentUserId}/${otherUserId}`);
                if (!response.ok) {
                    throw new Error('Failed to fetch messages');
                }
                const data = await response.json();

                // Clear the existing content
                messageContainer.innerHTML = '';

                // Loop through messages and create elements
                data.forEach((message) => {
                    // Compare senderId with the current user's ID to determine the type
                    const type = message.senderId === currentUserId ? 'sent' : 'received';
                    console.log(`senderUserId:${message.senderId},receiverUserId:${message.receiverId},Message ID: ${message.id}, Type: ${type}`); // Debugging to verify the type
                    appendMessage(type, message.content, message.timestamp);
                });
            } catch (error) {
                console.error('Error fetching messages:', error);
            }
        };

        function openChat(userName, userImg, userId) {
            selectedUserId = userId; // Store the selected user's ID
            const $chatMessages = $('#chatMessages');
            const $chatHeader = $('#chatHeader');
            const $chatInputContainer = $('#chatInputContainer');

            // Clear chat messages
            $chatMessages.empty();

            // Show the chat input when a chat is selected
            $chatInputContainer.css('display', 'flex');

            // Update chat header
            $chatHeader.html(`
                    <img src="${userImg}" alt="${userName}" class="rounded-circle me-2" style="width: 40px; height: 40px;">
                    <span>${userName}</span>
                `);

            // Hide "No messages yet" message in the usersActiveContainer
            const $noMessagesParagraph = $usersActiveContainer.find('.text-muted.text-center');
            if ($noMessagesParagraph.length) {
                $noMessagesParagraph.hide();
            }

            // Fetch and display previous messages for the selected user
            fetchAndDisplayMessages(currentUserId, userId);
        }

        async function sendMessage() {
            const $input = $('#messageInput');
            const messageContent = $input.val().trim();
            if (messageContent !== '') {
                const time = new Date();

                // Append the message locally
                appendMessage('sent', messageContent, time);

                // Clear the input field
                $input.val('');
                const bodyData = {
                    receiver_id: selectedUserId,
                    content: messageContent
                };
                try {
                    let response = await fetch('/api/messages/send', {
                        method: 'POST',
                        headers: {
                            "Content-Type": "application/json",
                            "X-Requested-With": "XMLHttpRequest"
                        },
                        body: JSON.stringify(bodyData),
                    });

                    let responseAjax = await response.json();
                    // const messageDiv = document.getElementById("message-status"); // Element to show the status of the message
                    //
                    // if (responseAjax.success) {
                    //     messageDiv.innerHTML = responseAjax.message; // Display success message
                    // } else {
                    //     messageDiv.innerHTML = responseAjax.error; // Display error message
                    // }
                } catch (error) {
                    console.error("Error sending message:", error);
                }
            }
        }

        function appendMessage(type, text, timestamp) {
            const $chatMessages = $('#chatMessages');

            // Format the timestamp to show only the time
            const time = new Date(timestamp).toLocaleTimeString([], {
                hour: '2-digit',
                minute: '2-digit',
            });

            // Create the message div
            const $messageDiv = $('<div></div>')
                .addClass('chat-message')
                .addClass(type);

            // Create the message content span
            const $messageContent = $('<span></span>')
                .addClass('message-content')
                .text(text);

            // Create the message time span
            const $messageTime = $('<span></span>')
                .addClass('message-time')
                .text(time);

            // Append the content and time to the message div
            $messageDiv.append($messageContent);
            $messageDiv.append($messageTime);

            // Append the message div to the chat messages container
            $chatMessages.append($messageDiv);
        }

        function selectFile(type) {
            const fileInput = document.createElement('input');
            fileInput.type = 'file';
            fileInput.accept = type === 'image' ? 'image/*' : (type === 'video' ? 'video/*' : '*/*');
            fileInput.onchange = function(event) {
                const selectedFile = event.target.files[0];
                if (selectedFile) {
                    // Call the function to send the selected file
                    sendFile(selectedFile, type);
                }
            };
            fileInput.click(); // Trigger the file input dialog
        }

        function sendFile(file, type) {
            // Display the file in the chat
            const reader = new FileReader();
            reader.onload = function(e) {
                const chatMessages = document.getElementById('chatMessages');
                const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                let content;

                // Determine the type of file and create the appropriate content
                if (type === 'image') {
                    content = `<img src="${e.target.result}" class="img-thumbnail" style="max-width: 100px; max-height: 100px;" alt="Image">`;
                } else if (type === 'video') {
                    content = `<video controls style="max-width: 200px; max-height: 200px;">
                        <source src="${e.target.result}" type="${file.type}">
                        Your browser does not support the video tag.
                    </video>`;
                } else if (type === 'audio') {
                    content = `<audio controls style="max-width: 200px;">
                        <source src="${e.target.result}" type="${file.type}">
                        Your browser does not support the audio element.
                    </audio>`;
                } else {
                    content = `<a href="${e.target.result}" download>${file.name}</a>`;
                }

                // Append the message using the same format as the regular messages
                const messageDiv = document.createElement('div');
                messageDiv.classList.add('chat-message', 'sent');

                const messageContent = document.createElement('span');
                messageContent.classList.add('message-content');
                messageContent.innerHTML = content; // Use innerHTML to allow HTML content

                const messageTime = document.createElement('span');
                messageTime.classList.add('message-time');
                messageTime.innerText = time;

                messageDiv.appendChild(messageContent);
                messageDiv.appendChild(messageTime);
                chatMessages.appendChild(messageDiv);

                // Scroll to the bottom
                chatMessages.scrollTop = chatMessages.scrollHeight;
            };

            reader.readAsDataURL(file); // Read the file as a data URL
        }

        $(document).ready(function () {

            var listscrollbarmessage = $('.listmessage .scrollbar');

            if (scrollbarlistmessage.length > 0) {
                scrollbarlistmessage.scrollbar();
            }

            var scrollbarchatarea = $('.chat-area .scrollbar');
            if (scrollbarchatarea.length > 0) {
                scrollbarchatarea.scrollbar();
            }

            // Header Search Toggle

            var $searchWrapper = $('.header-search-wrapper'),
                $body = $('body'),
                $searchToggle = $('.search-toggle');

            $searchToggle.on('click', function (e) {
                $searchWrapper.toggleClass('show');
                $(this).toggleClass('active');
                $searchWrapper.find('input').focus();
                e.preventDefault();
            });

            $body.on('click', function (e) {
                if ( $searchWrapper.hasClass('show') ) {
                    $searchWrapper.removeClass('show');
                    $searchToggle.removeClass('active');
                    $body.removeClass('is-search-active');
                }
            });

            $('.header-search').on('click', function (e) {
                e.stopPropagation();
            });
            // Header Search Toggle

            // send message by clicking the enter keyboard
            // Listen for the Enter key on the message input
            $('#messageInput').on('keypress', function (event) {
                if (event.which === 13) { // 13 is the Enter key
                    event.preventDefault(); // Prevents the default action (like form submission)
                    sendMessage(); // Call the send message function
                }
            });

            // Listen for input on the search field
            $('#Inputsearch').on('input', function () {
                const searchValue = $(this).val().toLowerCase().trim();

                // Filter the message items
                $('.message-item').each(function (index) {
                    const userName = $(this).find('h6').text().toLowerCase().trim();

                    if (userName.startsWith(searchValue)) {
                        $(this).css('display', 'flex'); // Show matching items
                    } else {
                        $(this).attr('style', 'display: none !important'); // Force hide non-matching items
                    }
                });

                // Handle case for empty search
                if (searchValue === '') {
                    $('.message-item').css('display', 'flex'); // Reset to show all items
                }
            });

            // Listen for input on the search header field
            $('#chatSearch').on('input', function () {
                const searchValue = $(this).val().toLowerCase().trim();
                let firstMatchScrolled = false; // To track if the first match has been scrolled into view

                // If the input is empty, remove the highlight class from all messages
                if (searchValue === '') {
                    $('.chat-message').removeClass('highlight');
                    return; // Exit early since there's nothing to search
                }

                // Filter the message items
                $('.chat-message').each(function () {
                    const content = $(this).find('.message-content').text().toLowerCase().trim();

                    // Check if the content starts with or includes the search value
                    if (content.startsWith(searchValue) || content.includes(searchValue)) {
                        $(this).addClass('highlight'); // Add the highlight class to matching messages

                        // Scroll to the first matching message
                        if (!firstMatchScrolled) {
                            this.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            firstMatchScrolled = true; // Ensure only the first match is scrolled
                        }
                    } else {
                        $(this).removeClass('highlight'); // Remove highlight if not matching
                    }
                });

                if (!firstMatchScrolled && searchValue !== '') {
                    console.log('No matches found.'); // Optional: Log if no matches were found
                }
            });

        });

    </script>


