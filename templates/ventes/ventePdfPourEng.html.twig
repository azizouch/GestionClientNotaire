<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/html">
<head>
    <meta charset="UTF-8">
    {% set allPersons = vente.pmorale | merge(vente.pphysique) %}

    {% set promettantPersons = allPersons | filter(person => 'Promettant' in person.getRoles | map(role => role.name)) %}
    {% set beneficiairePersons = allPersons | filter(person => 'Bénéficiaire' in person.getRoles | map(role => role.name)) %}

    {% set firstPromettant = promettantPersons | first %}
    {% set firstBeneficiaire = beneficiairePersons | first %}

    {% set index = 1 %}
    {% set compayName = "" %}

    <title>Vente de
        {% if firstBeneficiaire is not null %}
            {% if firstBeneficiaire.FirstName is defined and firstBeneficiaire.LastName is defined %}
                {{ firstBeneficiaire.FirstName }} {{ firstBeneficiaire.LastName }}
            {% else %}
                {{ firstBeneficiaire.name }}
            {% endif %}
        {% endif %}
        &
        {% if firstPromettant is not null %}
            {% if firstPromettant.FirstName is defined and firstPromettant.LastName is defined %}
                {{ firstPromettant.FirstName }} {{ firstPromettant.LastName }}
            {% else %}
                {% set compayName = firstPromettant.name %}
                {{ firstPromettant.name }}
            {% endif %}
        {% endif %}
    </title>
    <style>
        body { font-family: Arial, sans-serif;line-height: 1.4; }
        strong { font-family: "Times New Roman";font-size:16px; }
        .strong2 { font-family: 'Verdana', sans-serif;font-weight: bold;font-size:15px; }
    </style>
</head>
<body>
<table style="width: 100%; border-collapse: collapse;">
    <tr>
        <td style="text-align: left; width: 50%;">REP {{ vente.Repertoir }}</td>
        <td style="text-align: right; width: 50%;">Le {% if vente.DateMaitre == vente.DateBeneficiaire %}
                {{ vente.DateMaitre|date('d/m/Y') }}
            {% else %}
                {{ vente.DateBeneficiaire|date('d/m/Y') }} et {{ vente.DateMaitre|date('d/m/Y') }}
            {% endif %}
        </td>
    </tr>
    <tr>
        <td colspan="2" style="text-align: center; width: 100%;"><span style="font-size: 13px">VENTE TOTALE par SOCIETE </span><strong style="font-size: 16px">« {{ compayName}} »</strong></td>
    </tr>
    <tr>
        <td colspan="2" style="text-align: center; width: 100%;">
            <span style="font-size: 13px">au profit de </span>
            {% for person in beneficiairePersons %}
                <strong style="font-size: 16px">« {{ person.Civilite|upper }} {{ person.FirstName|upper }} {{ person.LastName|upper }} »</strong>
                {% if not loop.last %} et {% endif %}
            {% endfor %}
        </td>
    </tr>
    <tr>
        <td colspan="2" style="width: 100%;"><strong style="font-size: 16px">EXPEDITION COMFORME A LA MINUTE</strong> délivrée au service de l’enregistrement et du timbre suivant
            L’article 137 du code général des impôts.  </td>
    </tr>
</table>
