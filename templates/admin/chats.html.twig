    <script>

        function selectFile(type) {
            const fileInput = document.createElement('input');
            fileInput.type = 'file';
            fileInput.accept = type === 'image' ? 'image/*' : (type === 'video' ? 'video/*' : '*/*');
            fileInput.onchange = function(event) {
                const selectedFile = event.target.files[0];
                if (selectedFile) {
                    // Call the function to send the selected file
                    sendFile(selectedFile, type);
                }
            };
            fileInput.click(); // Trigger the file input dialog
        }

        function sendFile(file, type) {
            // Display the file in the chat
            const reader = new FileReader();
            reader.onload = function(e) {
                const chatMessages = document.getElementById('chatMessages');
                const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                let content;

                // Determine the type of file and create the appropriate content
                if (type === 'image') {
                    content = `<img src="${e.target.result}" class="img-thumbnail" style="max-width: 100px; max-height: 100px;" alt="Image">`;
                } else if (type === 'video') {
                    content = `<video controls style="max-width: 200px; max-height: 200px;">
                        <source src="${e.target.result}" type="${file.type}">
                        Your browser does not support the video tag.
                    </video>`;
                } else if (type === 'audio') {
                    content = `<audio controls style="max-width: 200px;">
                        <source src="${e.target.result}" type="${file.type}">
                        Your browser does not support the audio element.
                    </audio>`;
                } else {
                    content = `<a href="${e.target.result}" download>${file.name}</a>`;
                }

                // Append the message using the same format as the regular messages
                const messageDiv = document.createElement('div');
                messageDiv.classList.add('chat-message', 'sent');

                const messageContent = document.createElement('span');
                messageContent.classList.add('message-content');
                messageContent.innerHTML = content; // Use innerHTML to allow HTML content

                const messageTime = document.createElement('span');
                messageTime.classList.add('message-time');
                messageTime.innerText = time;

                messageDiv.appendChild(messageContent);
                messageDiv.appendChild(messageTime);
                chatMessages.appendChild(messageDiv);

                // Scroll to the bottom
                chatMessages.scrollTop = chatMessages.scrollHeight;
            };

            reader.readAsDataURL(file); // Read the file as a data URL
        }

        function openChat(userName, imageUrl) {
            document.getElementById('chatName').innerText = userName;
            const chatMessages = document.getElementById('chatMessages');
            chatMessages.innerHTML = ''; // Clear existing messages

            // Update the profile image in the chat header
            const profileImage = document.querySelector('.chat-header img');
            profileImage.src = imageUrl; // Change the image source to the selected user's image

            // Example: Load chat history
            const messages = [
                { type: 'received', text: 'Hello! How are you?', time: '10:45 AM' },
                { type: 'sent', text: 'I\'m good, thanks! How about you?', time: '10:46 AM' },
            ];

            messages.forEach((message) => {
                appendMessage(message.type, message.text, message.time);
            });

            // Show the chat input when a chat is selected
            document.getElementById('chatInputContainer').style.display = 'flex';
        }

        function sendMessage() {
            const input = document.getElementById('messageInput');
            const chatMessages = document.getElementById('chatMessages');

            if (input.value.trim() !== '') {
                const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                appendMessage('sent', input.value, time);
                input.value = '';

                // Scroll to the bottom
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }
        }

        function appendMessage(type, text, time) {
            const chatMessages = document.getElementById('chatMessages');

            const messageDiv = document.createElement('div');
            messageDiv.classList.add('chat-message', type);

            const messageContent = document.createElement('span');
            messageContent.classList.add('message-content');
            messageContent.innerText = text;

            const messageTime = document.createElement('span');
            messageTime.classList.add('message-time');
            messageTime.innerText = time;

            messageDiv.appendChild(messageContent);
            messageDiv.appendChild(messageTime);
            chatMessages.appendChild(messageDiv);
        }

        $(document).ready(function () {

            var scrollbarlistmessage = $('.listmessage .scrollbar');
            if (scrollbarlistmessage.length > 0) {
                scrollbarlistmessage.scrollbar();
            }

            var scrollbarchatarea = $('.chat-area .scrollbar');
            if (scrollbarchatarea.length > 0) {
                scrollbarchatarea.scrollbar();
            }

            // Header Search Toggle

            var $searchWrapper = $('.header-search-wrapper'),
                $body = $('body'),
                $searchToggle = $('.search-toggle');

            $searchToggle.on('click', function (e) {
                $searchWrapper.toggleClass('show');
                $(this).toggleClass('active');
                $searchWrapper.find('input').focus();
                e.preventDefault();
            });

            $body.on('click', function (e) {
                if ( $searchWrapper.hasClass('show') ) {
                    $searchWrapper.removeClass('show');
                    $searchToggle.removeClass('active');
                    $body.removeClass('is-search-active');
                }
            });

            $('.header-search').on('click', function (e) {
                e.stopPropagation();
            });
            // Header Search Toggle

            // send message by clicking the enter keyboard
            // Listen for the Enter key on the message input
            $('#messageInput').on('keypress', function (event) {
                if (event.which === 13) { // 13 is the Enter key
                    event.preventDefault(); // Prevents the default action (like form submission)
                    sendMessage(); // Call the send message function
                }
            });

            // Listen for input on the search field
            $('#Inputsearch').on('input', function () {
                const searchValue = $(this).val().toLowerCase().trim();

                // Filter the message items
                $('.message-item').each(function (index) {
                    const userName = $(this).find('h6').text().toLowerCase().trim();

                    if (userName.startsWith(searchValue)) {
                        $(this).css('display', 'flex'); // Show matching items
                    } else {
                        $(this).attr('style', 'display: none !important'); // Force hide non-matching items
                    }
                });

                // Handle case for empty search
                if (searchValue === '') {
                    $('.message-item').css('display', 'flex'); // Reset to show all items
                }
            });

            // Listen for input on the search header field
            $('#chatSearch').on('input', function () {
                const searchValue = $(this).val().toLowerCase().trim();
                let firstMatchScrolled = false; // To track if the first match has been scrolled into view

                // If the input is empty, remove the highlight class from all messages
                if (searchValue === '') {
                    $('.chat-message').removeClass('highlight');
                    return; // Exit early since there's nothing to search
                }

                // Filter the message items
                $('.chat-message').each(function () {
                    const content = $(this).find('.message-content').text().toLowerCase().trim();

                    // Check if the content starts with or includes the search value
                    if (content.startsWith(searchValue) || content.includes(searchValue)) {
                        $(this).addClass('highlight'); // Add the highlight class to matching messages

                        // Scroll to the first matching message
                        if (!firstMatchScrolled) {
                            this.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            firstMatchScrolled = true; // Ensure only the first match is scrolled
                        }
                    } else {
                        $(this).removeClass('highlight'); // Remove highlight if not matching
                    }
                });

                if (!firstMatchScrolled && searchValue !== '') {
                    console.log('No matches found.'); // Optional: Log if no matches were found
                }
            });

        });

    </script>

